/-!
# The term model on a cut

`NFUTerm.lean` builds the term model of NF on a cut of the natural numbers of a model of
NFU + Infinity. Here the same construction is carried out for any structure of numbers `N` (an
ordered commutative semiring) and sets of numbers `W` with a cut on which the clauses are sound:
for every `q` in the cut some set is a truth assignment that satisfies the instances of the
axioms N and of the nine clauses for the Axiom of Counting below `q` (`CutSys`). In the
application the numbers are those of the model of `𝗠𝗛` on the types of a model of `𝗡𝗙𝗨𝗜𝗖`, the
sets are the sets of that model, and soundness is `HinU.sound_K`.

* `Correct k s`: the state `s` of length `k` is the canonical one: each value is `1` exactly when
  the extension by `1` is good. Correct states agree (`correct_unique`, by the least number
  principle `CutSys.agree_ind`).
* `InI`: the cut of the terms; `Eps`, `Eta`: the interpreted membership and equality.
* `ax_*`: the instances of the clauses hold for `Eps`, `Eta` on the cut, without bounds
  (generated by `gen/gen_cutterm.py`).
* `talg`, `talg_ax`: so the terms of the cut are an algebra of terms in the sense of
  `TermAlg.lean`.
* `MinTm`: the least term of each class of `Eta`. **`dm_isNF`, `dm_counting`**: the least terms
  with `Eps` are a model of NF and of the Axiom of Counting, with true equality.
-/

namespace JensenNFU

variable {A W : Type} {memA : A → A → Prop} {mem : W → W → Prop} (e : A → W)

theorem isZeroN_map (he : Function.Bijective e) (hmem : ∀ a b, memA a b ↔ mem (e a) (e b))
    (z : A) : IsZeroN mem (e z) ↔ IsZeroN memA z := by
  constructor
  · intro h x
    rw [hmem, h (e x)]
    constructor
    · intro h' w
      rw [hmem]
      exact h' (e w)
    · intro h' w'
      obtain ⟨w, rfl⟩ := he.2 w'
      rw [← hmem]
      exact h' w
  · intro h x'
    obtain ⟨x, rfl⟩ := he.2 x'
    rw [← hmem, h x]
    constructor
    · intro h' w'
      obtain ⟨w, rfl⟩ := he.2 w'
      rw [← hmem]
      exact h' w
    · intro h' w
      rw [hmem]
      exact h' (e w)

theorem isSuccN_map (he : Function.Bijective e) (hmem : ∀ a b, memA a b ↔ mem (e a) (e b))
    (k k' : A) : IsSuccN mem (e k) (e k') ↔ IsSuccN memA k k' := by
  have key : ∀ y : A,
      (∃ x, mem x (e k) ∧ ∃ b, ¬mem b x ∧ ∀ z, mem z (e y) ↔ mem z x ∨ z = b) ↔
      (∃ x, memA x k ∧ ∃ b, ¬memA b x ∧ ∀ z, memA z y ↔ memA z x ∨ z = b) := by
    intro y
    constructor
    · rintro ⟨x', hx, b', hb, hall⟩
      obtain ⟨x, rfl⟩ := he.2 x'
      obtain ⟨b, rfl⟩ := he.2 b'
      refine ⟨x, (hmem _ _).mpr hx, b, fun h => hb ((hmem _ _).mp h), fun z => ?_⟩
      rw [hmem, hall (e z), ← hmem]
      exact or_congr Iff.rfl ⟨fun h => he.1 h, fun h => congrArg e h⟩
    · rintro ⟨x, hx, b, hb, hall⟩
      refine ⟨e x, (hmem _ _).mp hx, e b, fun h => hb ((hmem _ _).mpr h), fun z' => ?_⟩
      obtain ⟨z, rfl⟩ := he.2 z'
      rw [← hmem, hall z, ← hmem]
      exact or_congr Iff.rfl ⟨fun h => congrArg e h, fun h => he.1 h⟩
  constructor
  · intro h y
    rw [hmem, h (e y)]
    exact key y
  · intro h y'
    obtain ⟨y, rfl⟩ := he.2 y'
    rw [← hmem, h y]
    exact (key y).symm

theorem isNatN_map (he : Function.Bijective e) (hmem : ∀ a b, memA a b ↔ mem (e a) (e b))
    (n : A) (h : IsNatN memA n) : IsNatN mem (e n) := by
  rintro F' ⟨h0, hs⟩
  obtain ⟨F, rfl⟩ := he.2 F'
  rw [← hmem]
  exact h F ⟨fun z hz => (hmem _ _).mpr (h0 (e z) ((isZeroN_map e he hmem z).mpr hz)),
    fun k hk k' hk' => (hmem _ _).mpr (hs (e k) ((hmem _ _).mp hk) (e k')
      ((isSuccN_map e he hmem k k').mpr hk'))⟩

/-- **The Axiom of Counting is invariant under isomorphism.** -/
theorem Counting.of_bijective (he : Function.Bijective e)
    (hmem : ∀ a b, memA a b ↔ mem (e a) (e b)) (h : Counting mem) : Counting memA := by
  intro n hn x hx
  obtain ⟨y', hy, hall⟩ := h (e n) (isNatN_map e he hmem n hn) (e x) ((hmem _ _).mp hx)
  obtain ⟨y, rfl⟩ := he.2 y'
  refine ⟨y, (hmem _ _).mpr hy, fun s => ?_⟩
  rw [hmem, hall (e s)]
  constructor
  · rintro ⟨a', ha, hz⟩
    obtain ⟨a, rfl⟩ := he.2 a'
    refine ⟨a, (hmem _ _).mpr ha, fun z => ?_⟩
    rw [hmem, hz (e z)]
    exact ⟨fun h => he.1 h, fun h => congrArg e h⟩
  · rintro ⟨a, ha, hz⟩
    refine ⟨e a, (hmem _ _).mp ha, fun z' => ?_⟩
    obtain ⟨z, rfl⟩ := he.2 z'
    rw [← hmem, hz z]
    exact ⟨fun h => congrArg e h, fun h => he.1 h⟩

end JensenNFU

open NFUCut

/-- **Numbers, sets of numbers, and a cut on which the clauses are sound.** -/
structure CutSys (N W : Type) [CommSemiring N] [PartialOrder N] [IsOrderedRing N]
    [CanonicallyOrderedAdd N] where
  /-- The number is a member of the set. -/
  mem : N → W → Prop
  /-- The cut. -/
  cut : N → Prop
  cut_zero : cut 0
  cut_one : cut 1
  cut_add : ∀ {a b : N}, cut a → cut b → cut (a + b)
  cut_down : ∀ {a b : N}, a ≤ b → cut b → cut a
  eq_or_succ_le : ∀ {a b : N}, a ≤ b → a = b ∨ a + 1 ≤ b
  not_succ_le : ∀ a : N, ¬ a + 1 ≤ a
  le_of_succ_le_succ : ∀ {a b : N}, a + 1 ≤ b + 1 → a ≤ b
  le_total : ∀ a b : N, a ≤ b ∨ b ≤ a
  /-- Some set. -/
  emp : W
  /-- The set with one more member. -/
  adj : W → N → W
  mem_adj : ∀ {s : W} {k i : N}, mem i (adj s k) ↔ mem i s ∨ i = k
  /-- The set without one member. -/
  rem : W → N → W
  mem_rem : ∀ {s : W} {k i : N}, mem i (rem s k) ↔ mem i s ∧ i ≠ k
  /-- The least number principle for the disagreement of two sets below a bound. -/
  agree_ind : ∀ (s s' : W) (k : N),
    (∀ i, i + 1 ≤ k → (∀ j, j + 1 ≤ i → (mem j s ↔ mem j s')) → (mem i s ↔ mem i s')) →
    ∀ i, i + 1 ≤ k → (mem i s ↔ mem i s')
  /-- The least number principle for the equality atoms with a given right side. -/
  least : ∀ (s : W) (t : N), mem (aEq t t) s →
    ∃ m, m ≤ t ∧ mem (aEq m t) s ∧ ∀ m', m' ≤ t → mem (aEq m' t) s → m ≤ m'
  /-- Soundness on the cut. -/
  sound : ∀ q, cut q → ∃ τ : W, NSat (fun i => mem i τ) q ∧ CSat (fun i => mem i τ) q

namespace CutSys

variable {N W : Type} [CommSemiring N] [PartialOrder N] [IsOrderedRing N]
  [CanonicallyOrderedAdd N] (C : CutSys N W)

/-! ### Correct states -/

/-- `s` and `s'` have the same members below `k`. -/
def Agree (k : N) (s s' : W) : Prop := ∀ i : N, i + 1 ≤ k → (C.mem i s ↔ C.mem i s')

theorem agree_refl (k : N) (s : W) : C.Agree k s s := fun _ _ => Iff.rfl

theorem agree_symm {k : N} {s s' : W} (h : C.Agree k s s') : C.Agree k s' s :=
  fun i hi => (h i hi).symm

theorem agree_trans {k : N} {s s' s'' : W} (h : C.Agree k s s') (h' : C.Agree k s' s'') :
    C.Agree k s s'' := fun i hi => (h i hi).trans (h' i hi)

theorem agr_mono {i k : N} {s s' : W} (hik : i ≤ k) (h : C.Agree k s s') : C.Agree i s s' :=
  fun x hx => h x (le_trans hx hik)

include C in
theorem le_succ_iff {i k : N} : i ≤ k + 1 ↔ i ≤ k ∨ i = k + 1 := by
  constructor
  · intro h
    rcases C.eq_or_succ_le h with h1 | h1
    · exact Or.inr h1
    · exact Or.inl (C.le_of_succ_le_succ h1)
  · rintro (h | h)
    · exact le_trans h le_self_add
    · rw [h]

theorem agree_succ {k : N} {s s' : W} :
    C.Agree (k + 1) s s' ↔ C.Agree k s s' ∧ (C.mem k s ↔ C.mem k s') := by
  constructor
  · intro h
    exact ⟨C.agr_mono le_self_add h, h k (le_refl _)⟩
  · rintro ⟨h1, h2⟩ i hi
    have hik : i ≤ k := C.le_of_succ_le_succ hi
    rcases C.eq_or_succ_le hik with h | h
    · rw [h]
      exact h2
    · exact h1 i h

/-- The state extends to a truth assignment that satisfies the clauses below `q`. -/
def Sat1 (k : N) (s : W) (q : N) : Prop :=
  ∃ τ : W, C.Agree k τ s ∧ (NSat (fun i : N => C.mem i τ) q ∧ CSat (fun i : N => C.mem i τ) q)

/-- The state is good. -/
def Good (k : N) (s : W) : Prop := ∀ q, C.cut q → C.Sat1 k s q

theorem good_congr {k : N} {s s' : W} (h : C.Agree k s s') (hg : C.Good k s) : C.Good k s' :=
  fun q hq => by
    obtain ⟨τ, h1, h2⟩ := hg q hq
    exact ⟨τ, C.agree_trans h1 h, h2⟩

theorem good_mono {i k : N} {s : W} (hik : i ≤ k) (hg : C.Good k s) : C.Good i s :=
  fun q hq => by
    obtain ⟨τ, h1, h2⟩ := hg q hq
    exact ⟨τ, C.agr_mono hik h1, h2⟩

/-- The extension of the state by the value `1` is good. -/
def T1 (k : N) (s : W) : Prop :=
  ∃ s', C.Agree k s' s ∧ C.mem k s' ∧ C.Good (k + 1) s'

theorem t1_congr {k : N} {s s' : W} (h : C.Agree k s s') : C.T1 k s ↔ C.T1 k s' :=
  ⟨fun ⟨s1, h1, h2, h3⟩ => ⟨s1, C.agree_trans h1 h, h2, h3⟩,
    fun ⟨s1, h1, h2, h3⟩ => ⟨s1, C.agree_trans h1 (C.agree_symm h), h2, h3⟩⟩

/-- **The dichotomy.** A good state has a good extension by `1` or a good extension by `0`. -/
theorem dichotomy {k : N} {s : W} (h : C.Good k s) :
    C.T1 k s ∨ ∃ s', C.Agree k s' s ∧ ¬ C.mem k s' ∧ C.Good (k + 1) s' := by
  by_contra hne
  rw [not_or] at hne
  obtain ⟨hn1, hn0⟩ := hne
  have hk : ∀ i : N, i + 1 ≤ k → i ≠ k := fun i hi e => by
    rw [e] at hi
    exact C.not_succ_le k hi
  have ag1 : C.Agree k (C.adj s k) s := fun i hi => by
    rw [C.mem_adj]
    exact ⟨fun h' => h'.elim id (fun e => absurd e (hk i hi)), Or.inl⟩
  have ag0 : C.Agree k (C.rem s k) s := fun i hi => by
    rw [C.mem_rem]
    exact ⟨fun h' => h'.1, fun h' => ⟨h', hk i hi⟩⟩
  have m1 : C.mem k (C.adj s k) := C.mem_adj.mpr (Or.inr rfl)
  have m0 : ¬ C.mem k (C.rem s k) := fun h' => (C.mem_rem.mp h').2 rfl
  have b1 : ¬ C.Good (k + 1) (C.adj s k) := fun hg => hn1 ⟨_, ag1, m1, hg⟩
  have b0 : ¬ C.Good (k + 1) (C.rem s k) := fun hg => hn0 ⟨_, ag0, m0, hg⟩
  unfold Good at b1 b0
  push Not at b1 b0
  obtain ⟨q1, hq1, hs1⟩ := b1
  obtain ⟨q0, hq0, hs0⟩ := b0
  obtain ⟨τ, hτ, hns, hcs⟩ := h (q0 + q1) (C.cut_add hq0 hq1)
  by_cases hkτ : C.mem k τ
  · exact hs1 ⟨τ, C.agree_succ.mpr ⟨C.agree_trans hτ (C.agree_symm ag1),
      ⟨fun _ => m1, fun _ => hkτ⟩⟩, hns.mono le_add_self, hcs.mono le_add_self⟩
  · exact hs0 ⟨τ, C.agree_succ.mpr ⟨C.agree_trans hτ (C.agree_symm ag0),
      ⟨fun h' => absurd h' hkτ, fun h' => absurd h' m0⟩⟩, hns.mono le_self_add,
      hcs.mono le_self_add⟩

/-- The state is correct. -/
def Correct (k : N) (s : W) : Prop :=
  (∀ i, i ≤ k → C.Good i s) ∧ ∀ i : N, i + 1 ≤ k → (C.mem i s ↔ C.T1 i s)

theorem correct_down {i k : N} {s : W} (h : C.Correct k s) (hik : i ≤ k) : C.Correct i s :=
  ⟨fun x hx => h.1 x (le_trans hx hik), fun x hx => h.2 x (le_trans hx hik)⟩

theorem correct_congr {k : N} {s s' : W} (hag : C.Agree k s s') (h : C.Correct k s) :
    C.Correct k s' :=
  ⟨fun i hi => C.good_congr (C.agr_mono hi hag) (h.1 i hi),
    fun i hi => ((hag i hi).symm.trans (h.2 i hi)).trans
      (C.t1_congr (C.agr_mono (le_trans le_self_add hi) hag))⟩

theorem correct_zero : C.Correct 0 C.emp := by
  have hno : ∀ i : N, ¬ i + 1 ≤ 0 := fun i hi =>
    C.not_succ_le i (le_trans hi zero_le)
  refine ⟨fun i hi q hq => ?_, fun i hi => absurd hi (hno i)⟩
  obtain ⟨τ, hτ⟩ := C.sound q hq
  have e : i = 0 := le_antisymm hi zero_le
  rw [e]
  exact ⟨τ, fun x hx => absurd hx (hno x), hτ⟩

/-- A correct state has a correct extension by one more value. -/
theorem correct_succ {k : N} {s : W} (h : C.Correct k s) :
    ∃ s', C.Correct (k + 1) s' := by
  have key : ∀ s', C.Agree k s' s → C.Good (k + 1) s' → (C.mem k s' ↔ C.T1 k s) →
      C.Correct (k + 1) s' := by
    intro s' hag hgood hval
    have hc := C.correct_congr (C.agree_symm hag) h
    refine ⟨fun i hi => ?_, fun i hi => ?_⟩
    · rcases C.le_succ_iff.mp hi with h1 | h1
      · exact hc.1 i h1
      · rw [h1]
        exact hgood
    · have hik : i ≤ k := C.le_of_succ_le_succ hi
      rcases C.eq_or_succ_le hik with h1 | h1
      · rw [h1]
        exact hval.trans (C.t1_congr (C.agree_symm hag))
      · exact hc.2 i h1
  by_cases hT : C.T1 k s
  · obtain ⟨s1, hag, hk1, hgood⟩ := hT
    exact ⟨s1, key s1 hag hgood ⟨fun _ => ⟨s1, hag, hk1, hgood⟩, fun _ => hk1⟩⟩
  · rcases C.dichotomy (h.1 k (le_refl k)) with h1 | ⟨s0, hag, hk0, hgood⟩
    · exact absurd h1 hT
    · exact ⟨s0, key s0 hag hgood ⟨fun h' => absurd h' hk0, fun h' => absurd h' hT⟩⟩

/-- Correct states agree. -/
theorem correct_unique {k k' : N} {s s' : W} (h : C.Correct k s) (h' : C.Correct k' s')
    (hkk : k ≤ k') : C.Agree k s s' :=
  C.agree_ind s s' k fun i hi hag =>
    ((h.2 i hi).trans (C.t1_congr hag)).trans (h'.2 i (le_trans hi hkk)).symm

/-! ### The cut of the terms -/

/-- The numbers of the cut that are the length of a correct state. -/
def InJ (k : N) : Prop := C.cut k ∧ ∃ s, C.Correct k s

theorem inJ_hyp : Shortening.Hyp C.InJ (fun n : N => n) (fun n : N => n + 1) where
  down := fun hab ⟨h1, s, h2⟩ => ⟨C.cut_down hab h1, s, C.correct_down h2 hab⟩
  mono := fun h => h
  step := fun _ => rfl
  «exp» := fun ⟨h1, s, h2⟩ => ⟨C.cut_add h1 C.cut_one, C.correct_succ h2⟩
  base := ⟨C.cut_zero, C.emp, C.correct_zero⟩

/-- **The cut of the terms**: closed under addition and multiplication. -/
def InI (n : N) : Prop := Shortening.K C.InJ (fun n : N => n) n

theorem i_down {a b : N} (hab : a ≤ b) (hb : C.InI b) : C.InI a :=
  Shortening.K_down C.inJ_hyp hab hb

theorem i_zero : C.InI 0 := Shortening.K_zero

theorem i_one : C.InI 1 := Shortening.K_one

theorem i_add {a b : N} (ha : C.InI a) (hb : C.InI b) : C.InI (a + b) :=
  Shortening.K_add ha hb

theorem i_mul {a b : N} (ha : C.InI a) (hb : C.InI b) : C.InI (a * b) :=
  Shortening.K_mul ha hb

theorem i_sub {a : N} (ha : C.InI a) : C.InJ a := Shortening.K_sub C.inJ_hyp ha

theorem i_cast (k : ℕ) : C.InI (k : N) := by
  induction k with
  | zero =>
    rw [Nat.cast_zero]
    exact C.i_zero
  | succ k ih =>
    rw [Nat.cast_succ]
    exact C.i_add ih C.i_one

theorem i_npair {x y : N} (hx : C.InI x) (hy : C.InI y) : C.InI (npair x y) :=
  C.i_add (C.i_mul (C.i_add hx hy) (C.i_add hx hy)) hx

theorem i_tm (f : ℕ) {x y : N} (hx : C.InI x) (hy : C.InI y) : C.InI (tm f x y) :=
  C.i_add (C.i_npair (C.i_cast f) (C.i_npair hx hy)) C.i_one

theorem i_aIn {x y : N} (hx : C.InI x) (hy : C.InI y) : C.InI (aIn x y) :=
  C.i_add (C.i_npair hx hy) (C.i_npair hx hy)

theorem i_aEq {x y : N} (hx : C.InI x) (hy : C.InI y) : C.InI (aEq x y) :=
  C.i_add (C.i_aIn hx hy) C.i_one

/-- The interpretation of membership: the correct states give the atom `t ∈ t'` the value 1. -/
def Eps (t t' : N) : Prop :=
  ∃ s, C.Correct (aIn t t' + 1) s ∧ C.mem (aIn t t') s

/-- The interpretation of equality: the correct states give the atom `t = t'` the value 1. -/
def Eta (t t' : N) : Prop :=
  ∃ s, C.Correct (aEq t t' + 1) s ∧ C.mem (aEq t t') s

theorem val_iff {k : N} {s : W} (h : C.Correct k s) {i : N} (hi : i + 1 ≤ k) :
    (∃ s', C.Correct (i + 1) s' ∧ C.mem i s') ↔ C.mem i s := by
  constructor
  · rintro ⟨s', hc, hm⟩
    exact (C.correct_unique hc h hi i (le_refl _)).mp hm
  · exact fun hm => ⟨s, C.correct_down h hi, hm⟩

theorem exists_ibound (l : List N) (hl : ∀ a ∈ l, C.InI a) :
    ∃ k, C.InI k ∧ ∀ a ∈ l, a + 1 ≤ k := by
  induction l with
  | nil => exact ⟨0, C.i_zero, fun a ha => absurd ha (List.not_mem_nil)⟩
  | cons b l ih =>
    obtain ⟨k, hk, hb⟩ := ih (fun a ha => hl a (List.mem_cons_of_mem b ha))
    refine ⟨k + (b + 1), C.i_add hk (C.i_add (hl b List.mem_cons_self) C.i_one), fun a ha => ?_⟩
    rcases List.mem_cons.mp ha with h | h
    · rw [h]
      exact le_add_self
    · exact le_trans (hb a h) le_self_add

/-- **A correct state long enough for a list of atoms in the cut**: it satisfies the clauses
below its length, and its values at the atoms of the list are the values of `Eps` and `Eta`. -/
theorem exists_model_state (l : List N) (hl : ∀ a ∈ l, C.InI a) :
    ∃ (s : W) (k : N), NSat (fun i : N => C.mem i s) k ∧ CSat (fun i : N => C.mem i s) k ∧
      (∀ a ∈ l, a + 1 ≤ k) ∧
      (∀ t t' : N, aIn t t' ∈ l → (C.mem (aIn t t') s ↔ C.Eps t t')) ∧
      (∀ t t' : N, aEq t t' ∈ l → (C.mem (aEq t t') s ↔ C.Eta t t')) := by
  obtain ⟨k, hk, hb⟩ := C.exists_ibound l hl
  obtain ⟨hkt, s, hs⟩ := C.i_sub hk
  obtain ⟨τ, hτ, hns, hcs⟩ := hs.1 k (le_refl k) k hkt
  exact ⟨s, k, hns.congr hτ, hcs.congr hτ, hb, fun t t' h => (C.val_iff hs (hb _ h)).symm,
    fun t t' h => (C.val_iff hs (hb _ h)).symm⟩

/-! ### The clauses hold for `Eps` and `Eta` on the cut -/

theorem ax_e1 {x : N} (hx : C.InI x) :
    (C.Eta (x) (x)) := by
  obtain ⟨S₀, k₀, hns, hcs, hbd, hin, heq⟩ := C.exists_model_state [aEq (x) (x)] (by
    intro a ha
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl <;>
      repeat' first | assumption | exact C.i_zero | apply C.i_aIn | apply C.i_aEq | apply C.i_tm)
  have h := hns.e1 x (hbd (aEq (x) (x)) (by simp))
  beta_reduce at h
  rw [heq ((x)) ((x)) (by simp)] at h
  exact h

theorem ax_e2 {x y z : N} (hx : C.InI x) (hy : C.InI y) (hz : C.InI z) :
