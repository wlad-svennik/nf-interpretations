theorem ax_s2 {x b k : N} (hx : C.InI x) (hb : C.InI b) (hk : C.InI k) :
    (C.Eps x k) → ¬ (C.Eps b x) → (C.Eps (adT x b) (scT k)) := by
  obtain ⟨S₀, k₀, hns, hcs, hbd, hin, heq⟩ := C.exists_model_state [aIn x k, aIn b x, aIn (adT x b) (scT k)] (by
