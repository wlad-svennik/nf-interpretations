      repeat' first | assumption | exact C.i_zero | apply C.i_aIn | apply C.i_aEq | apply C.i_tm)
  have h := hcs.s2 x b k (hbd (aIn x k) (by simp)) (hbd (aIn b x) (by simp)) (hbd (aIn (adT x b) (scT k)) (by simp))
  beta_reduce at h
  rw [hin (x) (k) (by simp), hin (b) (x) (by simp), hin ((adT x b)) ((scT k)) (by simp)] at h
  exact h

