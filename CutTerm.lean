theorem ax_k {x n : N} (hx : C.InI x) (hn : C.InI n) :
    (C.Eps x n) → (C.Eps n ddT) → (C.Eps (usT x) n) := by
  obtain ⟨S₀, k₀, hns, hcs, hbd, hin, heq⟩ := C.exists_model_state [aIn x n, aIn n ddT, aIn (usT x) n] (by
    intro a ha
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl | rfl <;>
      repeat' first | assumption | exact C.i_zero | apply C.i_aIn | apply C.i_aEq | apply C.i_tm)
  have h := hcs.k x n (hbd (aIn x n) (by simp)) (hbd (aIn n ddT) (by simp)) (hbd (aIn (usT x) n) (by simp))
  beta_reduce at h
  rw [hin (x) (n) (by simp), hin (n) (ddT) (by simp), hin ((usT x)) (n) (by simp)] at h
  exact h

/-! ### The algebra of the terms of the cut -/

/-- The terms of the cut. -/
abbrev Tm : Type := {t : N // C.InI t}

/-- The terms of the cut, with `Eta` and `Eps`. -/
def talg : TAlg C.Tm where
  z := ⟨0, C.i_zero⟩
  tm f x y := ⟨tm f x.1 y.1, C.i_tm f x.2 y.2⟩
  E a b := C.Eta a.1 b.1
  Mm a b := C.Eps a.1 b.1

theorem talg_ax : C.talg.Ax where
  e1 := fun x => C.ax_e1 x.2
  e2 := fun x y z => C.ax_e2 x.2 y.2 z.2
  e3 := fun x x' y y' => C.ax_e3 x.2 x'.2 y.2 y'.2
  e4a := fun x x' => C.ax_e4a x.2 x'.2
  e4b := fun x x' y y' => C.ax_e4b x.2 x'.2 y.2 y'.2
  m1 := fun x y => C.ax_m1 x.2 y.2
  m2 := fun x y => C.ax_m2 x.2 y.2
  m3 := fun x y z => C.ax_m3 x.2 y.2 z.2
  m4 := fun x y z => C.ax_m4 x.2 y.2 z.2
  m5 := fun x z => C.ax_m5 x.2 z.2
  m6 := fun x z w => C.ax_m6 x.2 z.2 w.2
  m7 := fun x p s r => C.ax_m7 x.2 p.2 s.2 r.2
  m8 := fun x p s r => C.ax_m8 x.2 p.2 s.2 r.2
  m9a := fun x p => C.ax_m9a x.2 p.2
  m9b := fun x p s r => C.ax_m9b x.2 p.2 s.2 r.2
  m10a := fun x p s => C.ax_m10a x.2 p.2 s.2
  m10b := fun x p => C.ax_m10b x.2 p.2
  m11 := fun x p s => C.ax_m11 x.2 p.2 s.2
  m12a := fun p => C.ax_m12a p.2
  m12b := fun p s => C.ax_m12b p.2 s.2
  m13a := fun p s r => C.ax_m13a p.2 s.2 r.2
  m13b := fun p s => C.ax_m13b p.2 s.2
  u1a := fun s x => C.ax_u1a s.2 x.2
  u1b := fun s x => C.ax_u1b s.2 x.2
  u2 := fun a x => C.ax_u2 a.2 x.2
  s1a := fun y k => C.ax_s1a y.2 k.2
  s1b := fun y k => C.ax_s1b y.2 k.2
  s2 := fun x b k => C.ax_s2 x.2 b.2 k.2
  n1 := C.ax_n1
  n2 := fun k => C.ax_n2 k.2
  k := fun x n => C.ax_k x.2 n.2

/-! ### The least terms -/

theorem eta_refl {x : N} (hx : C.InI x) : C.Eta x x := C.ax_e1 hx

theorem eta_symm {x y : N} (hx : C.InI x) (hy : C.InI y) (h : C.Eta x y) : C.Eta y x :=
  C.ax_e2 (x := x) (y := y) (z := x) hx hy hx h (C.eta_refl hx)

theorem eta_trans {x y z : N} (hx : C.InI x) (hy : C.InI y) (hz : C.InI z) (h : C.Eta x y)
    (h' : C.Eta y z) : C.Eta x z :=
  C.ax_e2 (x := y) (y := x) (z := z) hy hx hz (C.eta_symm hx hy h) h'

theorem aEq_mono_left {s t : N} (h : s ≤ t) : aEq s t ≤ aEq t t := by
  unfold aEq npair
  gcongr

/-- `s` is the least member of its class of `Eta`, and lies in the cut of the terms. -/
def MinTm (s : N) : Prop := C.InI s ∧ ∀ s' : N, s' + 1 ≤ s → ¬ C.Eta s' s

/-- Every term in the cut is `Eta`-equal to a least one. -/
theorem exists_minTm {t : N} (ht : C.InI t) : ∃ s, C.MinTm s ∧ C.Eta s t := by
  have hk : C.InI (aEq t t + 1) := C.i_add (C.i_aEq ht ht) C.i_one
  obtain ⟨-, S₀, hS⟩ := C.i_sub hk
  have key : ∀ s : N, s ≤ t → (C.Eta s t ↔ C.mem (aEq s t) S₀) := fun s hs =>
    C.val_iff hS (add_le_add_left (aEq_mono_left hs) 1)
  obtain ⟨s0, hs0t, hs0S, hmin⟩ := C.least S₀ t ((key t (le_refl t)).mp (C.eta_refl ht))
  have hs0I : C.InI s0 := C.i_down hs0t ht
  have hs0η : C.Eta s0 t := (key s0 hs0t).mpr hs0S
  refine ⟨s0, ⟨hs0I, fun s' hs' hη => ?_⟩, hs0η⟩
  have hs's0 : s' ≤ s0 := le_trans le_self_add hs'
  have hs't : s' ≤ t := le_trans hs's0 hs0t
  have hη' : C.Eta s' t := C.eta_trans (C.i_down hs's0 hs0I) hs0I ht hη hs0η
  have := hmin s' hs't ((key s' hs't).mp hη')
  exact C.not_succ_le s' (le_trans hs' this)

/-- Two least terms that are `Eta`-equal are equal. -/
theorem minTm_unique {s s' : N} (hs : C.MinTm s) (hs' : C.MinTm s') (h : C.Eta s s') :
    s = s' := by
  rcases C.le_total s s' with h1 | h1
  · rcases C.eq_or_succ_le h1 with e | e
    · exact e
    · exact absurd h (hs'.2 s e)
  · rcases C.eq_or_succ_le h1 with e | e
    · exact e.symm
    · exact absurd (C.eta_symm hs.1 hs'.1 h) (hs.2 s' e)

/-- The least terms. -/
abbrev Dm : Type := {t : N // C.MinTm t}

theorem dm_bij : Function.Bijective
    (fun x : C.Dm => C.talg.nmk C.talg_ax (⟨x.1, x.2.1⟩ : C.Tm)) := by
  refine ⟨fun x y hxy => ?_, fun w => ?_⟩
  · have h1 : C.Eta x.1 y.1 := (C.talg.nmk_eq C.talg_ax).mp hxy
    exact Subtype.ext (C.minTm_unique x.2 y.2 h1)
  · obtain ⟨a, rfl⟩ := C.talg.nmk_surj C.talg_ax w
    obtain ⟨s, hs, hsa⟩ := C.exists_minTm a.2
    exact ⟨⟨s, hs⟩, (C.talg.nmk_eq C.talg_ax).mpr hsa⟩

/-- **The least terms with `Eps` are a model of NF**, with true equality. -/
theorem dm_isNF : ConNF.NF.IsNF C.Dm (fun a b => C.Eps a.1 b.1) :=
  ConNF.NF.IsNF.of_bijective _ C.dm_bij (fun _ _ => Iff.rfl) (C.talg.isNF C.talg_ax)

/-- **The least terms with `Eps` satisfy the Axiom of Counting.** -/
theorem dm_counting : JensenNFU.Counting (fun a b : C.Dm => C.Eps a.1 b.1) :=
  JensenNFU.Counting.of_bijective _ C.dm_bij (fun _ _ => Iff.rfl) (C.talg.counting C.talg_ax)

theorem dm_nonempty : Nonempty C.Dm := by
  obtain ⟨s, hs, -⟩ := C.exists_minTm C.i_zero
  exact ⟨⟨s, hs⟩⟩

end CutSys
