  obtain ⟨S₀, k₀, hns, hcs, hbd, hin, heq⟩ := C.exists_model_state [aIn s (usT x), aIn (elT s) x] (by
    intro a ha
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl <;>
      repeat' first | assumption | exact C.i_zero | apply C.i_aIn | apply C.i_aEq | apply C.i_tm)
  have h := hcs.u1b s x (hbd (aIn s (usT x)) (by simp)) (hbd (aIn (elT s) x) (by simp))
  beta_reduce at h
  rw [hin (s) ((usT x)) (by simp), hin ((elT s)) (x) (by simp)] at h
  exact h

