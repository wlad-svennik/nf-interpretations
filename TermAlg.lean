module

public import CountClauses

@[expose] public section

set_option autoImplicit false

/-!
# The term model of an algebra of terms

`TermN` of `CountClauses.lean` is the term model of a truth assignment on the standard numbers
that satisfies every instance of the axioms N and of the nine clauses for the Axiom of Counting.
Here the same construction is done for any type `T` of terms with operations for the 22 symbols,
an interpreted equality `E` and an interpreted membership `Mm` that satisfy the clauses without
bounds (`TAlg.Ax`). The terms in a cut of the numbers of a model are an instance
(`CutTerm.lean`).

* `TAlg.model`: the terms modulo `E`, with `Mm`, are a model of the finite axiomatisation of NF;
* `TAlg.counting`: the model satisfies the Axiom of Counting.

Generated by `gen/gen_talg.py` from the fields of `NSat`, `CSat` and the text of `TermN`.
-/

/-- Terms with the operations for the symbols (`tm f x y` is the term with the symbol `f` and the
arguments `x`, `y`; `z` fills the unused places), an equality and a membership. -/
structure TAlg (T : Type) where
  z : T
  tm : ℕ → T → T → T
  E : T → T → Prop
  Mm : T → T → Prop

namespace TAlg

variable {T : Type} (A : TAlg T)

def sgT (x : T) : T := A.tm 0 x A.z
def upT (x y : T) : T := A.tm 1 x y
def inT (x y : T) : T := A.tm 2 x y
def coT (x : T) : T := A.tm 3 x A.z
def siT (x : T) : T := A.tm 4 x A.z
def i2T (x : T) : T := A.tm 5 x A.z
def i3T (x : T) : T := A.tm 6 x A.z
def vcT (x : T) : T := A.tm 7 x A.z
def tlT (x : T) : T := A.tm 8 x A.z
def cvT (x : T) : T := A.tm 9 x A.z
def c1T : T := A.tm 10 A.z A.z
def sbT : T := A.tm 11 A.z A.z
def dT (x y : T) : T := A.tm 12 x y
def p1T (x : T) : T := A.tm 13 x A.z
def p2T (x : T) : T := A.tm 14 x A.z
def elT (x : T) : T := A.tm 15 x A.z
def wtT (x y : T) : T := A.tm 16 x y
def wsT (x y : T) : T := A.tm 17 x y
def usT (x : T) : T := A.tm 18 x A.z
def ddT : T := A.tm 19 A.z A.z
def scT (k : T) : T := A.tm 20 k A.z
def w1T (y k : T) : T := A.tm 21 y k
def opT (x y : T) : T := A.upT (A.sgT x) (A.upT x y)
def emT : T := A.inT A.c1T (A.coT A.c1T)
def zrT : T := A.sgT A.emT
def unT (x y : T) : T := A.coT (A.inT (A.coT x) (A.coT y))
def adT (x b : T) : T := A.unT x (A.sgT b)
def rmT (y b : T) : T := A.inT y (A.coT (A.sgT b))

/-- The axioms N and the nine clauses for the Axiom of Counting, without bounds. -/
structure Ax : Prop where
  e1 : ∀ x : T, (A.E (x) (x))
  e2 : ∀ x y z : T, (A.E (x) (y)) → (A.E (x) (z)) → (A.E (y) (z))
  e3 : ∀ x x' y y' : T, (A.E (x) (x')) → (A.E (y) (y')) → (A.Mm (x) (y)) → (A.Mm (x') (y'))
  e4a : ∀ x x' : T, (A.E (x) (x')) → (A.E (A.sgT x) (A.sgT x'))
  e4b : ∀ x x' y y' : T, (A.E (x) (x')) → (A.E (y) (y')) → (A.E (A.upT x y) (A.upT x' y'))
  m1 : ∀ x y : T, ((A.Mm (A.dT x y) (x)) ↔ (A.Mm (A.dT x y) (y))) → (A.E (x) (y))
  m2 : ∀ x y : T, ((A.Mm (y) (A.sgT x)) ↔ (A.E (y) (x)))
  m3 : ∀ x y z : T, ((A.Mm (z) (A.upT x y)) ↔ (A.E (z) (x)) ∨ (A.E (z) (y)))
  m4 : ∀ x y z : T, ((A.Mm (z) (A.inT x y)) ↔ (A.Mm (z) (x)) ∧ (A.Mm (z) (y)))
  m5 : ∀ x z : T, ((A.Mm (z) (A.coT x)) ↔ ¬ (A.Mm (z) (x)))
  m6 : ∀ x z w : T, ((A.Mm (A.opT (A.sgT z) (A.sgT w)) (A.siT x)) ↔ (A.Mm (A.opT z w) (x)))
  m7 : ∀ x p s r : T, ((A.Mm (A.opT (A.sgT (A.sgT p)) (A.opT s r)) (A.i2T x)) ↔ (A.Mm (A.opT p r) (x)))
  m8 : ∀ x p s r : T, ((A.Mm (A.opT (A.sgT (A.sgT p)) (A.opT s r)) (A.i3T x)) ↔ (A.Mm (A.opT p s) (x)))
  m9a : ∀ x p : T, (A.Mm (p) (A.vcT x)) → (A.E (p) (A.opT (A.p1T p) (A.p2T p))) ∧ (A.Mm (A.p2T p) (x))
  m9b : ∀ x p s r : T, (A.E (p) (A.opT s r)) → (A.Mm (r) (x)) → (A.Mm (p) (A.vcT x))
  m10a : ∀ x p s : T, (A.Mm (p) (A.tlT x)) → (A.Mm (A.opT s (A.sgT p)) (x))
  m10b : ∀ x p : T, (A.Mm (A.opT (A.wtT p x) (A.sgT p)) (x)) → (A.Mm (p) (A.tlT x))
  m11 : ∀ x p s : T, ((A.Mm (A.opT p s) (A.cvT x)) ↔ (A.Mm (A.opT s p) (x)))
  m12a : ∀ p : T, (A.Mm (p) (A.c1T)) → (A.E (p) (A.sgT (A.elT p)))
  m12b : ∀ p s : T, (A.E (p) (A.sgT s)) → (A.Mm (p) (A.c1T))
  m13a : ∀ p s r : T, (A.Mm (A.opT p s) (A.sbT)) → (A.Mm (r) (p)) → (A.Mm (r) (s))
  m13b : ∀ p s : T, ((A.Mm (A.wsT p s) (p)) → (A.Mm (A.wsT p s) (s))) → (A.Mm (A.opT p s) (A.sbT))
  u1a : ∀ s x : T, (A.Mm s (A.usT x)) → (A.E s (A.sgT (A.elT s)))
  u1b : ∀ s x : T, (A.Mm s (A.usT x)) → (A.Mm (A.elT s) x)
  u2 : ∀ a x : T, (A.Mm a x) → (A.Mm (A.sgT a) (A.usT x))
  s1a : ∀ y k : T, (A.Mm y (A.scT k)) → (A.Mm (A.rmT y (A.w1T y k)) k)
  s1b : ∀ y k : T, (A.Mm y (A.scT k)) → (A.Mm (A.w1T y k) y)
  s2 : ∀ x b k : T, (A.Mm x k) → ¬ (A.Mm b x) → (A.Mm (A.adT x b) (A.scT k))
  n1 : (A.Mm A.zrT A.ddT)
  n2 : ∀ k : T, (A.Mm k A.ddT) → (A.Mm (A.scT k) A.ddT)
  k : ∀ x n : T, (A.Mm x n) → (A.Mm n A.ddT) → (A.Mm (A.usT x) n)

variable (hA : A.Ax)
include hA

theorem eta_symm {x y : T} (h : (A.E x y)) : (A.E y x) := hA.e2 x y x h (hA.e1 x)

theorem eta_trans {x y z : T} (h : (A.E x y)) (h' : (A.E y z)) : (A.E x z) :=
  hA.e2 y x z (A.eta_symm hA h) h'

/-- The interpreted equality on the terms. -/
def tmSetoid : Setoid T where
  r a b := (A.E a b)
  iseqv := ⟨fun a => hA.e1 a, fun h => A.eta_symm hA h, fun h h' => A.eta_trans hA h h'⟩

/-- The carrier of the model: the terms modulo the interpreted equality. -/
def NV : Type := Quotient (A.tmSetoid hA)

/-- The class of a code. -/
def nmk (a : T) : A.NV hA := Quotient.mk (A.tmSetoid hA) a

theorem nmk_eq {a b : T} : A.nmk hA a = A.nmk hA b ↔ (A.E a b) :=
  ⟨fun h => Quotient.exact h, fun h => Quotient.sound h⟩

/-- The interpreted membership, on the classes. -/
def nmem : A.NV hA → A.NV hA → Prop :=
  Quotient.lift₂ (s₁ := A.tmSetoid hA) (s₂ := A.tmSetoid hA) (fun a b => (A.Mm a b))
    (fun a b a' b' ha hb => propext ⟨fun h => hA.e3 a a' b b' ha hb h,
      fun h => hA.e3 a' a b' b (A.eta_symm hA ha) (A.eta_symm hA hb) h⟩)

/-- The singleton, on the classes. -/
def nsing : A.NV hA → A.NV hA :=
  Quotient.map (sa := A.tmSetoid hA) (sb := A.tmSetoid hA) (fun a => A.sgT a)
    (fun a b h => hA.e4a a b h)

/-- The unordered pair, on the classes. -/
def nup : A.NV hA → A.NV hA → A.NV hA :=
  Quotient.map₂ (sa := A.tmSetoid hA) (sb := A.tmSetoid hA) (sc := A.tmSetoid hA)
    (fun a b => A.upT a b) (fun a a' ha b b' hb => hA.e4b a a' b b' ha hb)

theorem nmem_mk (a b : T) : A.nmem hA (A.nmk hA a) (A.nmk hA b) ↔ (A.Mm a b) := Iff.rfl

theorem nsing_mk (a : T) : A.nsing hA (A.nmk hA a) = A.nmk hA (A.sgT a) := rfl

theorem nup_mk (a b : T) : A.nup hA (A.nmk hA a) (A.nmk hA b) = A.nmk hA (A.upT a b) := rfl

theorem nop_mk (a b : T) :
    A.nup hA (A.nsing hA (A.nmk hA a)) (A.nup hA (A.nmk hA a) (A.nmk hA b)) = A.nmk hA (A.opT a b) := rfl

theorem nmk_surj (x : A.NV hA) : ∃ a : T, x = A.nmk hA a :=
  Quotient.inductionOn x (fun a => ⟨a, rfl⟩)

set_option maxHeartbeats 400000 in
/-- **The term model of a truth assignment that satisfies N.** -/
def model : ConNF.NF.NFModel (A.NV hA) where
  mem := A.nmem hA
  sing := A.nsing hA
  up := A.nup hA
  ext := by
    intro x y
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    obtain ⟨b, rfl⟩ := A.nmk_surj hA y
    intro h
    exact (A.nmk_eq hA).mpr (hA.m1 a b (h (A.nmk hA (A.dT a b))))
  mem_sing := by
    intro x y
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    obtain ⟨b, rfl⟩ := A.nmk_surj hA y
    exact (hA.m2 a b).trans (A.nmk_eq hA).symm
  mem_up := by
    intro x y z
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    obtain ⟨b, rfl⟩ := A.nmk_surj hA y
    obtain ⟨c, rfl⟩ := A.nmk_surj hA z
    exact (hA.m3 a b c).trans (or_congr (A.nmk_eq hA).symm (A.nmk_eq hA).symm)
  inter := by
    intro x y
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    obtain ⟨b, rfl⟩ := A.nmk_surj hA y
    refine ⟨A.nmk hA (A.inT a b), fun z => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA z
    exact hA.m4 a b c
  compl := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.coT a), fun z => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA z
    exact hA.m5 a c
  singletonImage := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.siT a), fun z w => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA z
    obtain ⟨e, rfl⟩ := A.nmk_surj hA w
    exact hA.m6 a c e
  insertion2 := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.i2T a), fun p q r => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    obtain ⟨e, rfl⟩ := A.nmk_surj hA q
    obtain ⟨f, rfl⟩ := A.nmk_surj hA r
    exact hA.m7 a c e f
  insertion3 := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.i3T a), fun p q r => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    obtain ⟨e, rfl⟩ := A.nmk_surj hA q
    obtain ⟨f, rfl⟩ := A.nmk_surj hA r
    exact hA.m8 a c e f
  vCross := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.vcT a), fun p => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    constructor
    · intro h
      obtain ⟨h1, h2⟩ := hA.m9a a c h
      refine ⟨A.nmk hA (A.p1T c), A.nmk hA (A.p2T c), ?_, h2⟩
      show A.nmk hA c = A.nup hA (A.nsing hA (A.nmk hA (A.p1T c))) (A.nup hA (A.nmk hA (A.p1T c)) (A.nmk hA (A.p2T c)))
      rw [nop_mk]
      exact (A.nmk_eq hA).mpr h1
    · rintro ⟨q, r, e, hm⟩
      obtain ⟨e', rfl⟩ := A.nmk_surj hA q
      obtain ⟨f, rfl⟩ := A.nmk_surj hA r
      change A.nmk hA c = A.nup hA (A.nsing hA (A.nmk hA e')) (A.nup hA (A.nmk hA e') (A.nmk hA f)) at e
      rw [nop_mk] at e
      exact hA.m9b a c e' f ((A.nmk_eq hA).mp e) hm
  typeLower := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.tlT a), fun p => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    constructor
    · intro h q
      obtain ⟨e, rfl⟩ := A.nmk_surj hA q
      exact hA.m10a a c e h
    · intro h
      exact hA.m10b a c (h (A.nmk hA (A.wtT c a)))
  converse := by
    intro x
    obtain ⟨a, rfl⟩ := A.nmk_surj hA x
    refine ⟨A.nmk hA (A.cvT a), fun p q => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    obtain ⟨e, rfl⟩ := A.nmk_surj hA q
    exact hA.m11 a c e
  cardinalOne := by
    refine ⟨A.nmk hA A.c1T, fun p => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    constructor
    · intro h
      refine ⟨A.nmk hA (A.elT c), ?_⟩
      show A.nmk hA c = A.nsing hA (A.nmk hA (A.elT c))
      rw [nsing_mk]
      exact (A.nmk_eq hA).mpr (hA.m12a c h)
    · rintro ⟨q, e⟩
      obtain ⟨e', rfl⟩ := A.nmk_surj hA q
      change A.nmk hA c = A.nsing hA (A.nmk hA e') at e
      rw [nsing_mk] at e
      exact hA.m12b c e' ((A.nmk_eq hA).mp e)
  subset := by
    refine ⟨A.nmk hA A.sbT, fun p q => ?_⟩
    obtain ⟨c, rfl⟩ := A.nmk_surj hA p
    obtain ⟨e, rfl⟩ := A.nmk_surj hA q
    constructor
    · intro h r
      obtain ⟨f, rfl⟩ := A.nmk_surj hA r
      exact hA.m13a c e f h
    · intro h
      exact hA.m13b c e (h (A.nmk hA (A.wsT c e)))

/-- The term model satisfies extensionality and every instance of stratified comprehension. -/
theorem isNF : ConNF.NF.IsNF (A.NV hA) (A.nmem hA) := (A.model hA).isNF

/-! ### Membership in the terms of this file -/

theorem ext' {a b : T} (h : ∀ c : T, (A.Mm c a) ↔ (A.Mm c b)) : (A.E a b) :=
  hA.m1 a b (h (A.dT a b))

theorem mem_em (z : T) : ¬ (A.Mm z A.emT) := fun h =>
  (hA.m5 A.c1T z).mp ((hA.m4 A.c1T (A.coT A.c1T) z).mp h).2 ((hA.m4 A.c1T (A.coT A.c1T) z).mp h).1

theorem mem_un (x y z : T) : (A.Mm z (A.unT x y)) ↔ (A.Mm z x) ∨ (A.Mm z y) := by
  unfold TAlg.unT
  rw [hA.m5, hA.m4, hA.m5, hA.m5]
  tauto

theorem mem_ad (x b z : T) : (A.Mm z (A.adT x b)) ↔ (A.Mm z x) ∨ (A.E z b) := by
  unfold TAlg.adT
  rw [A.mem_un hA, hA.m2]

theorem mem_rm (y b z : T) : (A.Mm z (A.rmT y b)) ↔ (A.Mm z y) ∧ ¬ (A.E z b) := by
  unfold TAlg.rmT
  rw [hA.m4, hA.m5, hA.m2]

/-! ### The Axiom of Counting in the term model -/


/-- Every zero of the term model is the class of `A.zrT`. -/
theorem zero_eq {z : A.NV hA} (hz : JensenNFU.IsZeroN (A.nmem hA) z) : z = A.nmk hA A.zrT := by
  obtain ⟨a, rfl⟩ := A.nmk_surj hA z
  refine (A.nmk_eq hA).mpr (A.ext' hA fun c => ?_)
  have h1 := hz (A.nmk hA c)
  rw [nmem_mk] at h1
  rw [h1]
  unfold TAlg.zrT
  rw [hA.m2]
  constructor
  · intro h
    exact A.ext' hA fun w => ⟨fun hw => absurd ((A.nmem_mk hA w c).mpr hw) (h (A.nmk hA w)),
      fun hw => absurd hw (A.mem_em hA w)⟩
  · intro h w hw
    obtain ⟨b, rfl⟩ := A.nmk_surj hA w
    exact A.mem_em hA b (hA.e3 b b c A.emT (hA.e1 b) h ((A.nmem_mk hA b c).mp hw))

/-- Every successor of the class of `a` is the class of `A.scT a`. -/
theorem succ_eq {a : T} {k' : A.NV hA} (hk : JensenNFU.IsSuccN (A.nmem hA) (A.nmk hA a) k') :
    k' = A.nmk hA (A.scT a) := by
  obtain ⟨a', rfl⟩ := A.nmk_surj hA k'
  refine (A.nmk_eq hA).mpr (A.ext' hA fun c => ?_)
  have h1 := hk (A.nmk hA c)
  rw [nmem_mk] at h1
  rw [h1]
  constructor
  · rintro ⟨x, hx, b, hb, hall⟩
    obtain ⟨x0, rfl⟩ := A.nmk_surj hA x
    obtain ⟨b0, rfl⟩ := A.nmk_surj hA b
    have h2 := hA.s2 x0 b0 a ((A.nmem_mk hA x0 a).mp hx) (fun h => hb ((A.nmem_mk hA b0 x0).mpr h))
    have h3 : (A.E (A.adT x0 b0) c) := A.ext' hA fun z => by
      rw [A.mem_ad hA]
      have h4 := hall (A.nmk hA z)
      rw [nmem_mk, nmem_mk, nmk_eq] at h4
      exact h4.symm
    exact hA.e3 (A.adT x0 b0) c (A.scT a) (A.scT a) h3 (hA.e1 _) h2
  · intro h
    have h2 := hA.s1a c a h
    have h3 := hA.s1b c a h
    refine ⟨A.nmk hA (A.rmT c (A.w1T c a)), (A.nmem_mk hA _ _).mpr h2, A.nmk hA (A.w1T c a), ?_, fun z => ?_⟩
    · rw [nmem_mk, A.mem_rm hA]
      exact fun h4 => h4.2 (hA.e1 _)
    · obtain ⟨z0, rfl⟩ := A.nmk_surj hA z
      rw [nmem_mk, nmem_mk, nmk_eq, A.mem_rm hA]
      constructor
      · intro hz
        by_cases he : (A.E z0 (A.w1T c a))
        · exact Or.inr he
        · exact Or.inl ⟨hz, he⟩
      · rintro (hz | hz)
        · exact hz.1
        · exact hA.e3 (A.w1T c a) z0 c c (A.eta_symm hA hz) (hA.e1 c) h3

/-- **The term model of a truth assignment that satisfies N and the nine clauses satisfies the
Axiom of Counting.** -/
theorem counting : JensenNFU.Counting (A.nmem hA) := by
  intro n hn x hx
  have hD : A.nmem hA n (A.nmk hA A.ddT) := by
    refine hn (A.nmk hA A.ddT) ⟨fun z hz => ?_, fun k hk k' hk' => ?_⟩
    · rw [A.zero_eq hA hz, nmem_mk]
      exact hA.n1
    · obtain ⟨a, rfl⟩ := A.nmk_surj hA k
      rw [A.succ_eq hA hk', nmem_mk]
      exact hA.n2 a ((A.nmem_mk hA a A.ddT).mp hk)
  obtain ⟨a, rfl⟩ := A.nmk_surj hA n
  obtain ⟨c, rfl⟩ := A.nmk_surj hA x
  have hca : (A.Mm c a) := (A.nmem_mk hA c a).mp hx
  refine ⟨A.nmk hA (A.usT c), (A.nmem_mk hA _ _).mpr (hA.k c a hca ((A.nmem_mk hA a A.ddT).mp hD)),
    fun s => ?_⟩
  obtain ⟨e, rfl⟩ := A.nmk_surj hA s
  rw [nmem_mk]
  constructor
  · intro h
    have h1 := hA.u1a e c h
    have h2 := hA.u1b e c h
    refine ⟨A.nmk hA (A.elT e), (A.nmem_mk hA _ _).mpr h2, fun z => ?_⟩
    obtain ⟨z0, rfl⟩ := A.nmk_surj hA z
    rw [nmem_mk, nmk_eq, ← hA.m2]
    exact ⟨fun hz => hA.e3 z0 z0 e (A.sgT (A.elT e)) (hA.e1 z0) h1 hz,
      fun hz => hA.e3 z0 z0 (A.sgT (A.elT e)) e (hA.e1 z0) (A.eta_symm hA h1) hz⟩
  · rintro ⟨a', ha', hall⟩
    obtain ⟨f, rfl⟩ := A.nmk_surj hA a'
    have h1 := hA.u2 f c ((A.nmem_mk hA f c).mp ha')
    have h2 : (A.E (A.sgT f) e) := A.ext' hA fun z => by
      rw [hA.m2]
      have h3 := hall (A.nmk hA z)
      rw [nmem_mk, nmk_eq] at h3
      exact h3.symm
    exact hA.e3 (A.sgT f) e (A.usT c) (A.usT c) h2 (hA.e1 _) h1

end TAlg
