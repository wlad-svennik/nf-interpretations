module

public import HostTerm
public import CountClauses

@[expose] public section

set_option autoImplicit false

/-!
# The four symbols for the Axiom of Counting at the positions of a placement

`HostTerm.lean` has the selection conditions `T18`–`T21` of the symbols `US`, `DD`, `SC`, `W1`.
Here, for a flat model with the three further existence axioms `CAx`:

* what the values of `usT x`, `scT k`, `w1T y k`, `ddT` at a position of a placement are;
* the nine clauses of `CountClauses.lean` at shifted positions (`n_u2`, `n_u1`, `n_s2`, `n_s1`,
  `n_n1`, `n_n2`, `n_k`). The clause K is proved under the hypothesis that the number `m`
  with "the value of `n` is the set of the objects with `m` members" can be taken the same at
  two consecutive positions.

Generated by `gen/gen_hostcount.py`, which only expands the abbreviations for positions,
levels and values.
-/

namespace FlatM

variable {H : Host} {Fm : FlatM H}
variable {N : Type} [CommSemiring N] [PartialOrder N] {E : N → N} {num : N → H.W}

/-- The existence axioms for the symbols `US`, `SC` and `DD`, for descending levels. -/
structure CAx (Fm : FlatM H) : Prop where
  us : ∀ a a1 a2 x, Fm.Lt a1 a → Fm.Lt a2 a1 → Fm.Ob x a1 → ∃ y, Fm.Ob y a ∧ ∀ s, Fm.Ob s a1 →
    (Fm.El s y (H.op a a1) ↔ ∃ w, Fm.Ob w a2 ∧ Fm.El w x (H.op a1 a2) ∧ Fm.IsSg a1 a2 w s)
  sc : ∀ a a1 a2 c, Fm.Lt a1 a → Fm.Lt a2 a1 → Fm.Ob c a → ∃ y, Fm.Ob y a ∧ ∀ o, Fm.Ob o a1 →
    (Fm.El o y (H.op a a1) ↔ ∃ x b, Fm.Ob x a1 ∧ Fm.El x c (H.op a a1) ∧ Fm.Ob b a2 ∧
      ¬ Fm.El b x (H.op a1 a2) ∧
      ∀ z, Fm.Ob z a2 → (Fm.El z o (H.op a1 a2) ↔ Fm.El z x (H.op a1 a2) ∨ z = b))
  dd : ∀ a a1 a2 a3, Fm.Lt a1 a → Fm.Lt a2 a1 → Fm.Lt a3 a2 → ∃ y, Fm.Ob y a ∧ ∀ n, Fm.Ob n a1 →
    (Fm.El n y (H.op a a1) ↔ ∃ m, m ∈ H.om ∧ Fm.IsNm a1 a2 a3 m n)

/-! ### The number of the members of an object -/

theorem sz_zero {a2 a3 x : H.W} :
    Fm.Sz a2 a3 x H.emp ↔ ∀ z, Fm.Ob z a3 → ¬ Fm.El z x (H.op a2 a3) := by
  constructor
  · rintro ⟨f, hf, -, h2, -⟩ z hz hel
    obtain ⟨i, hi⟩ := h2 z hz hel
    exact H.not_mem_emp i ((hf.2 i).mpr ⟨z, hi⟩)
  · intro h
    exact ⟨H.emp, H.funOn_emp, fun i z hi => (H.not_mem_emp _ (H.app_iff.mp hi)).elim,
      fun z hz hel => (h z hz hel).elim, fun i j z hi => (H.not_mem_emp _ (H.app_iff.mp hi)).elim⟩

theorem sz_succ {a2 a3 x y b m : H.W} (h : Fm.Sz a2 a3 x m) (hb : Fm.Ob b a3)
    (hbx : ¬ Fm.El b x (H.op a2 a3))
    (hy : ∀ z, Fm.Ob z a3 → (Fm.El z y (H.op a2 a3) ↔ Fm.El z x (H.op a2 a3) ∨ z = b)) :
    Fm.Sz a2 a3 y (H.suc m) := by
  obtain ⟨f, hf, h1, h2, h3⟩ := h
  refine ⟨H.ins f m b, H.funOn_ins hf, fun i z hi => ?_, fun z hz hel => ?_, fun i j z hi hj => ?_⟩
  · rcases H.app_ins.mp hi with h | ⟨-, rfl⟩
    · exact ⟨(h1 i z h).1, (hy z (h1 i z h).1).mpr (Or.inl (h1 i z h).2)⟩
    · exact ⟨hb, (hy z hb).mpr (Or.inr rfl)⟩
  · rcases (hy z hz).mp hel with h | h
    · obtain ⟨i, hi⟩ := h2 z hz h
      exact ⟨i, H.app_ins.mpr (Or.inl hi)⟩
    · exact ⟨m, H.app_ins.mpr (Or.inr ⟨rfl, h⟩)⟩
  · rcases H.app_ins.mp hi with h | ⟨e1, e2⟩
    · rcases H.app_ins.mp hj with h' | ⟨e3, e4⟩
      · exact h3 i j z h h'
      · rw [e4] at h
        exact (hbx (h1 i b h).2).elim
    · rcases H.app_ins.mp hj with h' | ⟨e3, e4⟩
      · rw [e2] at h'
        exact (hbx (h1 j b h').2).elim
      · rw [e1, e3]

theorem sz_pred {a2 a3 y m : H.W} (h : Fm.Sz a2 a3 y (H.suc m)) :
    ∃ b, Fm.Ob b a3 ∧ Fm.El b y (H.op a2 a3) ∧ ∀ x,
      (∀ z, Fm.Ob z a3 → (Fm.El z x (H.op a2 a3) ↔ Fm.El z y (H.op a2 a3) ∧ z ≠ b)) →
      Fm.Sz a2 a3 x m := by
  obtain ⟨f, hf, h1, h2, h3⟩ := h
  obtain ⟨b, hb⟩ := (hf.2 m).mp (H.mem_suc.mpr (Or.inr rfl))
  refine ⟨b, (h1 m b hb).1, (h1 m b hb).2, fun x hx => ?_⟩
  refine ⟨H.res f m, H.funOn_res hf (fun z hz => H.mem_suc.mpr (Or.inl hz)), fun i z hi => ?_,
    fun z hz hel => ?_, fun i j z hi hj => h3 i j z (H.app_res.mp hi).2 (H.app_res.mp hj).2⟩
  · obtain ⟨him, hiz⟩ := H.app_res.mp hi
    refine ⟨(h1 i z hiz).1, (hx z (h1 i z hiz).1).mpr ⟨(h1 i z hiz).2, fun e => ?_⟩⟩
    rw [e] at hiz
    rw [h3 i m b hiz hb] at him
    exact H.mem_irrefl _ him
  · obtain ⟨hzy, hzb⟩ := (hx z hz).mp hel
    obtain ⟨i, hi⟩ := h2 z hz hzy
    rcases H.mem_suc.mp ((hf.2 i).mpr ⟨z, hi⟩) with him | him
    · exact ⟨i, H.app_res.mpr ⟨him, hi⟩⟩
    · rw [him] at hi
      exact (hzb (hf.1.2 _ _ _ hi hb)).elim

/-- The set of the singletons of the members of an object has as many members as the object. -/
theorem sz_img (ax : Fm.Ax) {a a1 a2 x y m : H.W} (h1 : Fm.Lt a1 a) (h2 : Fm.Lt a2 a1)
    (hsz : Fm.Sz a1 a2 x m)
    (hy : ∀ s, Fm.Ob s a1 → (Fm.El s y (H.op a a1) ↔
      ∃ w, Fm.Ob w a2 ∧ Fm.El w x (H.op a1 a2) ∧ Fm.IsSg a1 a2 w s)) :
    Fm.Sz a a1 y m := by
  obtain ⟨f, hf, g1, g2, g3⟩ := hsz
  have hdO := Fm.defOb
  have hdE := Fm.defEl
  have hfun : ∀ u ∈ m, ∀ s s', (∃ w, H.App f u w ∧ Fm.IsSg a1 a2 w s) →
      (∃ w, H.App f u w ∧ Fm.IsSg a1 a2 w s') → s = s' := by
    rintro u - s s' ⟨w, hw, hs⟩ ⟨w', hw', hs'⟩
    rw [← hf.1.2 _ _ _ hw hw'] at hs'
    exact sg_unique ax h2 hs hs'
  refine ⟨H.mkFun m (fun u s => ∃ w, H.App f u w ∧ Fm.IsSg a1 a2 w s) (by hdef) hfun,
    ⟨H.isFun_mkFun, fun i => ⟨fun hi => ?_, fun ⟨s, hs⟩ => (H.app_mkFun.mp hs).1⟩⟩,
    fun i s hi => ?_, fun s hs hel => ?_, fun i j s hi hj => ?_⟩
  · obtain ⟨w, hw⟩ := (hf.2 i).mp hi
    obtain ⟨s, hs⟩ := ax.sing a1 a2 w h2 (g1 i w hw).1
    exact ⟨s, H.app_mkFun.mpr ⟨hi, w, hw, hs⟩⟩
  · obtain ⟨-, w, hw, hs⟩ := H.app_mkFun.mp hi
    exact ⟨hs.1, (hy s hs.1).mpr ⟨w, (g1 i w hw).1, (g1 i w hw).2, hs⟩⟩
  · obtain ⟨w, hw, hwx, hs'⟩ := (hy s hs).mp hel
    obtain ⟨i, hi⟩ := g2 w hw hwx
    exact ⟨i, H.app_mkFun.mpr ⟨(hf.2 i).mpr ⟨w, hi⟩, w, hi, hs'⟩⟩
  · obtain ⟨-, w, hw, hs⟩ := H.app_mkFun.mp hi
    obtain ⟨-, w', hw', hs'⟩ := H.app_mkFun.mp hj
    have e := sg_inj ax (g1 i w hw).1 hs hs'
    rw [← e] at hw'
    exact g3 i j w hw hw'

/-! ### The values of the terms at a position -/

section vals

variable (ar : H.Arith E num) (ax : Fm.Ax) {v : H.W} (hv : Fm.Plc v)
include ax hv

/-- The value of a term satisfies the selection condition of its symbol, if anything does. -/
theorem vl_tn (i : ℕ) (hi : i < 22) (x y : N) {k k1 k2 : H.W} (h1 : H.Sh (off1 i) k k1)
    (h2 : H.Sh (off2 i) k k2) (hk : ∃ b, H.App v k b) (hk1 : ∃ b, H.App v k1 b)
    (hk2 : ∃ b, H.App v k2 b)
    (hex : ∃ y', Fm.Tn i y' (Fm.vl ar (num x) k1 v) (Fm.vl ar (num y) k2 v) k v) :
    Fm.Tn i (Fm.vl ar (num (tm i x y)) k v) (Fm.vl ar (num x) k1 v) (Fm.vl ar (num y) k2 v)
      k v := by
  obtain ⟨a, d1, d2, ha, hd1, hd2, hpick⟩ :=
    (val_tm ar i hi h1 h2 hk1 hk2).mp (vl_spec ar ax hv hk)
  have e1 := Fm.val_fun ar hv.fn _ _ _ _ hd1 (vl_spec ar ax hv hk1)
  have e2 := Fm.val_fun ar hv.fn _ _ _ _ hd2 (vl_spec ar ax hv hk2)
  subst e1 e2
  exact pick_spec ar hi hex hpick

theorem mem_sgT (b : N) {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) :
    Fm.El z (Fm.vl ar (num (sgT b)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ z = (Fm.vl ar (num (b)) k0 v) :=
  (vs0 ar ax b 0 hv (hv.down hp1) hp1).2 z hz

theorem mem_inT (x y : N) {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) :
    Fm.El z (Fm.vl ar (num (inT x y)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ Fm.El z (Fm.vl ar (num (x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∧ Fm.El z (Fm.vl ar (num (y)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) :=
  (vs2 ar ax x y hv (hv.down hp1) hp1).2 z hz

theorem mem_coT (x : N) {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) :
    Fm.El z (Fm.vl ar (num (coT x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ ¬ Fm.El z (Fm.vl ar (num (x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) :=
  (vs3 ar ax x 0 hv (hv.down hp1) hp1).2 z hz

theorem mem_emT {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) : ¬ Fm.El z (Fm.vl ar (num (emT)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) := by
  intro h
  have h1 := (mem_inT ar ax hv c1T (coT c1T) hp1 hz).mp h
  exact (mem_coT ar ax hv c1T hp1 hz).mp h1.2 h1.1

theorem mem_adT (x b : N) {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) :
    Fm.El z (Fm.vl ar (num (adT x b)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ Fm.El z (Fm.vl ar (num (x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∨ z = (Fm.vl ar (num (b)) k0 v) := by
  have h1 := mem_coT ar ax hv (inT (coT x) (coT (sgT b))) hp1 hz
  have h2 := mem_inT ar ax hv (coT x) (coT (sgT b)) hp1 hz
  have h3 := mem_coT ar ax hv x hp1 hz
  have h4 := mem_coT ar ax hv (sgT b) hp1 hz
  have h5 := mem_sgT ar ax hv b hp1 hz
  unfold adT unT
  rw [h1, h2, h3, h4, h5]
  tauto

theorem mem_rmT (y b : N) {k0 : H.W} (hp1 : ∃ b, H.App v (H.suc k0) b) {z : H.W} (hz : Fm.Ob z (H.lvl v k0)) :
    Fm.El z (Fm.vl ar (num (rmT y b)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ Fm.El z (Fm.vl ar (num (y)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∧ z ≠ (Fm.vl ar (num (b)) k0 v) := by
  have h2 := mem_inT ar ax hv y (coT (sgT b)) hp1 hz
  have h4 := mem_coT ar ax hv (sgT b) hp1 hz
  have h5 := mem_sgT ar ax hv b hp1 hz
  unfold rmT
  rw [h2, h4, h5]

variable (cax : Fm.CAx)
include cax

/-- The value of `usT x`. -/
theorem vl_us (x : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Ob (Fm.vl ar (num (usT x)) (H.suc (H.suc k0)) v) (H.lvl v (H.suc (H.suc k0))) ∧ ∀ s, Fm.Ob s (H.lvl v (H.suc k0)) → (Fm.El s (Fm.vl ar (num (usT x)) (H.suc (H.suc k0)) v) (H.op (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0))) ↔
      ∃ w, Fm.Ob w (H.lvl v k0) ∧ Fm.El w (Fm.vl ar (num (x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∧ Fm.IsSg (H.lvl v (H.suc k0)) (H.lvl v k0) w s) := by
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have hex : ∃ y', Fm.Tn 18 y' (Fm.vl ar (num (x)) (H.suc k0) v) (Fm.vl ar (num (0)) (H.suc (H.suc k0)) v) (H.suc (H.suc k0)) v := by
    obtain ⟨y', hy1, hy2⟩ := cax.us (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) (Fm.vl ar (num (x)) (H.suc k0) v) (plc_lt hv hp1 hp2) (plc_lt hv hp0 hp1)
      (vl_ob ar ax hv hp1)
    exact ⟨y', (H.lvl v (H.suc (H.suc k0))), (H.lvl v (H.suc k0)), (H.lvl v k0), H.lvl_spec hp2, H.lm1_suc.mpr (H.lvl_spec hp1),
      H.lm2_suc.mpr (H.lm1_suc.mpr (H.lvl_spec hp0)), hy1, hy2⟩
  obtain ⟨a, a1, a2, h_a, h_a1, h_a2, hb⟩ :=
    vl_tn ar ax hv 18 (by decide) x 0 (k := (H.suc (H.suc k0))) (k1 := (H.suc k0)) (k2 := (H.suc (H.suc k0))) rfl rfl hp2 hp1 hp2 hex
  obtain rfl := H.lvl_eq hv.fn h_a
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp h_a1)
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp (H.lm2_suc.mp h_a2))
  exact hb

/-- The value of `scT c`. -/
theorem vl_sc (c : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Ob (Fm.vl ar (num (scT c)) (H.suc (H.suc k0)) v) (H.lvl v (H.suc (H.suc k0))) ∧ ∀ o, Fm.Ob o (H.lvl v (H.suc k0)) → (Fm.El o (Fm.vl ar (num (scT c)) (H.suc (H.suc k0)) v) (H.op (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0))) ↔
      ∃ x b, Fm.Ob x (H.lvl v (H.suc k0)) ∧ Fm.El x (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v) (H.op (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0))) ∧ Fm.Ob b (H.lvl v k0) ∧ ¬ Fm.El b x (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∧
        ∀ z, Fm.Ob z (H.lvl v k0) → (Fm.El z o (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ Fm.El z x (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∨ z = b)) := by
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have hex : ∃ y', Fm.Tn 20 y' (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v) (Fm.vl ar (num (0)) (H.suc (H.suc k0)) v) (H.suc (H.suc k0)) v := by
    obtain ⟨y', hy1, hy2⟩ := cax.sc (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v) (plc_lt hv hp1 hp2) (plc_lt hv hp0 hp1)
      (vl_ob ar ax hv hp2)
    exact ⟨y', (H.lvl v (H.suc (H.suc k0))), (H.lvl v (H.suc k0)), (H.lvl v k0), H.lvl_spec hp2, H.lm1_suc.mpr (H.lvl_spec hp1),
      H.lm2_suc.mpr (H.lm1_suc.mpr (H.lvl_spec hp0)), hy1, hy2⟩
  obtain ⟨a, a1, a2, h_a, h_a1, h_a2, hb⟩ :=
    vl_tn ar ax hv 20 (by decide) c 0 (k := (H.suc (H.suc k0))) (k1 := (H.suc (H.suc k0))) (k2 := (H.suc (H.suc k0))) rfl rfl hp2 hp2 hp2 hex
  obtain rfl := H.lvl_eq hv.fn h_a
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp h_a1)
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp (H.lm2_suc.mp h_a2))
  exact hb

/-- The value of `ddT`. -/
theorem vl_dd {k0 : H.W} (hp3 : ∃ b, H.App v (H.suc (H.suc (H.suc k0))) b) :
    Fm.Ob (Fm.vl ar (num (ddT)) (H.suc (H.suc (H.suc k0))) v) (H.lvl v (H.suc (H.suc (H.suc k0)))) ∧ ∀ n, Fm.Ob n (H.lvl v (H.suc (H.suc k0))) → (Fm.El n (Fm.vl ar (num (ddT)) (H.suc (H.suc (H.suc k0))) v) (H.op (H.lvl v (H.suc (H.suc (H.suc k0)))) (H.lvl v (H.suc (H.suc k0)))) ↔
      ∃ m, m ∈ H.om ∧ Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) m n) := by
  have hp2 := hv.down hp3
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have hex : ∃ y', Fm.Tn 19 y' (Fm.vl ar (num (0)) (H.suc (H.suc (H.suc k0))) v) (Fm.vl ar (num (0)) (H.suc (H.suc (H.suc k0))) v) (H.suc (H.suc (H.suc k0))) v := by
    obtain ⟨y', hy1, hy2⟩ := cax.dd (H.lvl v (H.suc (H.suc (H.suc k0)))) (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) (plc_lt hv hp2 hp3) (plc_lt hv hp1 hp2)
      (plc_lt hv hp0 hp1)
    exact ⟨y', (H.lvl v (H.suc (H.suc (H.suc k0)))), (H.lvl v (H.suc (H.suc k0))), (H.lvl v (H.suc k0)), (H.lvl v k0), H.lvl_spec hp3, H.lm1_suc.mpr (H.lvl_spec hp2),
      H.lm2_suc.mpr (H.lm1_suc.mpr (H.lvl_spec hp1)),
      H.lm3_suc.mpr (H.lm2_suc.mpr (H.lm1_suc.mpr (H.lvl_spec hp0))), hy1, hy2⟩
  obtain ⟨a, a1, a2, a3, h_a, h_a1, h_a2, h_a3, hb⟩ :=
    vl_tn ar ax hv 19 (by decide) 0 0 (k := (H.suc (H.suc (H.suc k0)))) (k1 := (H.suc (H.suc (H.suc k0)))) (k2 := (H.suc (H.suc (H.suc k0)))) rfl rfl hp3 hp3 hp3 hex
  obtain rfl := H.lvl_eq hv.fn h_a
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp h_a1)
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp (H.lm2_suc.mp h_a2))
  obtain rfl := H.lvl_eq hv.fn (H.lm1_suc.mp (H.lm2_suc.mp (H.lm3_suc.mp h_a3)))
  exact hb

/-! ### The clauses at shifted positions -/

theorem n_u2 (a x : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Tin ar a x k0 v → Fm.Tin ar (sgT a) (usT x) (H.suc k0) v := by
  intro h
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have hsg := vs0 ar ax a 0 hv hp0 hp1
  exact ((vl_us ar ax hv cax x hp2).2 _ hsg.1).mpr ⟨_, vl_ob ar ax hv hp0, h, hsg⟩

theorem n_u1 (s x : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Tin ar s (usT x) (H.suc k0) v →
      Fm.Teq ar s (sgT (elT s)) (H.suc k0) v ∧ Fm.Tin ar (elT s) x k0 v := by
  intro h
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  obtain ⟨w, hw, hwx, hsg⟩ := ((vl_us ar ax hv cax x hp2).2 _ (vl_ob ar ax hv hp1)).mp h
  have hel := vs15 ar ax s 0 hv hp0 hp1 ⟨w, hw, hsg⟩
  have e : w = (Fm.vl ar (num (elT s)) k0 v) := sg_inj ax hw hsg hel.2
  have hsg' := vs0 ar ax (elT s) 0 hv hp0 hp1
  refine ⟨sg_unique ax (plc_lt hv hp0 hp1) hel.2 hsg', ?_⟩
  show Fm.El (Fm.vl ar (num (elT s)) k0 v) (Fm.vl ar (num (x)) (H.suc k0) v) (H.op (H.lvl v (H.suc k0)) (H.lvl v k0))
  rw [← e]
  exact hwx

theorem n_s2 (x b c : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Tin ar x c (H.suc k0) v → ¬ Fm.Tin ar b x k0 v → Fm.Tin ar (adT x b) (scT c) (H.suc k0) v := by
  intro h1 h2
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  exact ((vl_sc ar ax hv cax c hp2).2 _ (vl_ob ar ax hv hp1)).mpr ⟨(Fm.vl ar (num (x)) (H.suc k0) v), (Fm.vl ar (num (b)) k0 v),
    vl_ob ar ax hv hp1, h1, vl_ob ar ax hv hp0, h2, fun z hz => mem_adT ar ax hv x b hp1 hz⟩

theorem n_s1 (y c : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) :
    Fm.Tin ar y (scT c) (H.suc k0) v →
      Fm.Tin ar (rmT y (w1T y c)) c (H.suc k0) v ∧ Fm.Tin ar (w1T y c) y k0 v := by
  intro h
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  obtain ⟨x, b, hx, hxc, hb, hbx, hall⟩ :=
    ((vl_sc ar ax hv cax c hp2).2 _ (vl_ob ar ax hv hp1)).mp h
  have hex : ∃ y', Fm.Tn 21 y' (Fm.vl ar (num (y)) (H.suc k0) v) (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v) k0 v :=
    ⟨b, (H.lvl v k0), (H.lvl v (H.suc k0)), (H.lvl v (H.suc (H.suc k0))), H.lvl_spec hp0, H.lvl_spec hp1, H.lvl_spec hp2, hb,
      (hall b hb).mpr (Or.inr rfl), x, hx, hxc, fun z hz => ⟨fun hzx =>
        ⟨(hall z hz).mpr (Or.inl hzx), fun e => hbx (e ▸ hzx)⟩,
        fun ⟨hzy, hzb⟩ => ((hall z hz).mp hzy).resolve_right hzb⟩⟩
  obtain ⟨a, u1, u2, h_a, h_u1, h_u2, hw, hwy, x', hx', hx'c, hall'⟩ :=
    vl_tn ar ax hv 21 (by decide) y c (k := k0) (k1 := (H.suc k0)) (k2 := (H.suc (H.suc k0))) rfl rfl hp0 hp1 hp2 hex
  obtain rfl := H.lvl_eq hv.fn h_a
  obtain rfl := H.lvl_eq hv.fn h_u1
  obtain rfl := H.lvl_eq hv.fn h_u2
  refine ⟨?_, hwy⟩
  have e : (Fm.vl ar (num (rmT y (w1T y c))) (H.suc k0) v) = x' :=
    ax.ext (H.lvl v (H.suc k0)) (H.lvl v k0) _ _ (plc_lt hv hp0 hp1) (vl_ob ar ax hv hp1) hx' fun z hz =>
      (mem_rmT ar ax hv y (w1T y c) hp1 hz).trans (hall' z hz).symm
  show Fm.El (Fm.vl ar (num (rmT y (w1T y c))) (H.suc k0) v) (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v) (H.op (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)))
  rw [e]
  exact hx'c

/-- The value of `zrT` is the set of the objects without members. -/
theorem isNm_zero {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) : Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) H.emp (Fm.vl ar (num (zrT)) (H.suc (H.suc k0)) v) := by
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  refine ⟨vl_ob ar ax hv hp2, fun x hx => ?_⟩
  have h1 : Fm.El x (Fm.vl ar (num (zrT)) (H.suc (H.suc k0)) v) (H.op (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0))) ↔ x = (Fm.vl ar (num (emT)) (H.suc k0) v) := mem_sgT ar ax hv emT (k0 := (H.suc k0)) hp2 hx
  rw [h1, sz_zero]
  constructor
  · rintro rfl z hz
    exact mem_emT ar ax hv hp1 hz
  · intro h
    exact ax.ext (H.lvl v (H.suc k0)) (H.lvl v k0) _ _ (plc_lt hv hp0 hp1) hx (vl_ob ar ax hv hp1) fun z hz =>
      ⟨fun hzx => (h z hz hzx).elim, fun hze => (mem_emT ar ax hv hp1 hz hze).elim⟩

theorem n_n1 {k0 : H.W} (hp3 : ∃ b, H.App v (H.suc (H.suc (H.suc k0))) b) : Fm.Tin ar zrT ddT (H.suc (H.suc k0)) v := by
  have hp2 := hv.down hp3
  exact ((vl_dd ar ax hv cax hp3).2 _ (vl_ob ar ax hv hp2)).mpr
    ⟨H.emp, H.emp_mem_om, isNm_zero ar ax hv cax hp2⟩

/-- The successor of the set of the objects with `m` members is the set of the objects with
`m + 1` members. -/
theorem isNm_succ (c : N) {k0 : H.W} (hp2 : ∃ b, H.App v (H.suc (H.suc k0)) b) {m : H.W} (h : Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) m (Fm.vl ar (num (c)) (H.suc (H.suc k0)) v)) :
    Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) (H.suc m) (Fm.vl ar (num (scT c)) (H.suc (H.suc k0)) v) := by
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have hlt := plc_lt hv hp0 hp1
  obtain ⟨hob, hsc⟩ := vl_sc ar ax hv cax c hp2
  refine ⟨hob, fun o ho => ?_⟩
  rw [hsc o ho]
  constructor
  · rintro ⟨x, b, hx, hxc, hb, hbx, hall⟩
    exact sz_succ ((h.2 x hx).mp hxc) hb hbx hall
  · intro hsz
    obtain ⟨b, hb, hbo, hpred⟩ := sz_pred hsz
    obtain ⟨s, hs⟩ := ax.sing (H.lvl v (H.suc k0)) (H.lvl v k0) b hlt hb
    obtain ⟨cs, hcs, hcs'⟩ := ax.compl (H.lvl v (H.suc k0)) (H.lvl v k0) s hlt hs.1
    obtain ⟨x, hx, hx'⟩ := ax.inter (H.lvl v (H.suc k0)) (H.lvl v k0) o cs hlt ho hcs
    have hxm : ∀ z, Fm.Ob z (H.lvl v k0) → (Fm.El z x (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ↔ Fm.El z o (H.op (H.lvl v (H.suc k0)) (H.lvl v k0)) ∧ z ≠ b) := fun z hz => by
      rw [hx' z hz, hcs' z hz, hs.2 z hz]
    refine ⟨x, b, hx, (h.2 x hx).mpr (hpred x hxm), hb, fun hbx => ((hxm b hb).mp hbx).2 rfl,
      fun z hz => ?_⟩
    rw [hxm z hz]
    constructor
    · intro hzo
      by_cases e : z = b
      · exact Or.inr e
      · exact Or.inl ⟨hzo, e⟩
    · rintro (hz' | hz')
      · exact hz'.1
      · rw [hz']
        exact hbo

theorem n_n2 (c : N) {k0 : H.W} (hp3 : ∃ b, H.App v (H.suc (H.suc (H.suc k0))) b) :
    Fm.Tin ar c ddT (H.suc (H.suc k0)) v → Fm.Tin ar (scT c) ddT (H.suc (H.suc k0)) v := by
  intro h
  have hp2 := hv.down hp3
  obtain ⟨m, hm, hnm⟩ := ((vl_dd ar ax hv cax hp3).2 _ (vl_ob ar ax hv hp2)).mp h
  exact ((vl_dd ar ax hv cax hp3).2 _ (vl_ob ar ax hv hp2)).mpr
    ⟨H.suc m, H.suc_mem_om hm, isNm_succ ar ax hv cax c hp2 hnm⟩

/-- **The clause K**, when the number of the members of the members of the value of `n` can be
taken the same at the two positions at which `n` is evaluated. -/
theorem n_k (x n : N) {k0 : H.W} (hp4 : ∃ b, H.App v (H.suc (H.suc (H.suc (H.suc k0)))) b)
    (hsame : ∀ m m', m ∈ H.om → m' ∈ H.om → Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) m (Fm.vl ar (num (n)) (H.suc (H.suc k0)) v) →
      Fm.IsNm (H.lvl v (H.suc (H.suc (H.suc k0)))) (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) m' (Fm.vl ar (num (n)) (H.suc (H.suc (H.suc k0))) v) →
      ∃ m₀, Fm.IsNm (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) (H.lvl v k0) m₀ (Fm.vl ar (num (n)) (H.suc (H.suc k0)) v) ∧ Fm.IsNm (H.lvl v (H.suc (H.suc (H.suc k0)))) (H.lvl v (H.suc (H.suc k0))) (H.lvl v (H.suc k0)) m₀ (Fm.vl ar (num (n)) (H.suc (H.suc (H.suc k0))) v)) :
    Fm.Tin ar x n (H.suc k0) v → Fm.Tin ar n ddT (H.suc (H.suc k0)) v → Fm.Tin ar n ddT (H.suc (H.suc (H.suc k0))) v →
      Fm.Tin ar (usT x) n (H.suc (H.suc k0)) v := by
  intro h1 h2 h3
  have hp3 := hv.down hp4
  have hp2 := hv.down hp3
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  obtain ⟨m, hm, hnm⟩ := ((vl_dd ar ax hv cax hp3).2 _ (vl_ob ar ax hv hp2)).mp h2
  obtain ⟨m', hm', hnm'⟩ :=
    ((vl_dd ar ax hv cax (k0 := (H.suc k0)) hp4).2 _ (vl_ob ar ax hv hp3)).mp h3
  obtain ⟨m₀, g1, g2⟩ := hsame m m' hm hm' hnm hnm'
  have hsz : Fm.Sz (H.lvl v (H.suc k0)) (H.lvl v k0) (Fm.vl ar (num (x)) (H.suc k0) v) m₀ := (g1.2 _ (vl_ob ar ax hv hp1)).mp h1
  obtain ⟨hob, hus⟩ := vl_us ar ax hv cax x hp2
  exact (g2.2 _ hob).mpr (sz_img ax (plc_lt hv hp1 hp2) (plc_lt hv hp0 hp1) hsz hus)

end vals

/-! ### The nine clauses on a sequence of levels on which the atoms are decided -/

set_option linter.unusedVariables false in
/-- **The truth assignment of a sequence of levels on which the atoms below `q` are decided
satisfies the nine clauses for the Axiom of Counting below `q`**, if for every `n` in the
clause K the number of the members of the members of the value of `n` can be taken the same at
two consecutive positions. -/
theorem csat_of_dec (ar : H.Arith E num) (ax : Fm.Ax) (cax : Fm.CAx) {e : H.W} {q R l : N}
    (he : H.IncSeq e (num l)) (hlv : ∀ k a, H.App e k a → Fm.Lv a) (hl : R + 5 + R + 1 ≤ l)
    (hdec : ∀ i : N, i + 1 ≤ q → Fm.AllT ar e (num i) (num R) ∨ Fm.AllF ar e (num i) (num R))
    (hnum : ∀ n : N, aIn n ddT + 1 ≤ q → ∀ m m', m ∈ H.om → m' ∈ H.om →
      Fm.IsNm (H.lvl e (H.suc (H.suc (num R)))) (H.lvl e (H.suc (num R))) (H.lvl e (num R)) m (Fm.vl ar (num n) (H.suc (H.suc (num R))) e) → Fm.IsNm (H.lvl e (H.suc (H.suc (H.suc (num R))))) (H.lvl e (H.suc (H.suc (num R)))) (H.lvl e (H.suc (num R))) m' (Fm.vl ar (num n) (H.suc (H.suc (H.suc (num R)))) e) →
      ∃ m₀, Fm.IsNm (H.lvl e (H.suc (H.suc (num R)))) (H.lvl e (H.suc (num R))) (H.lvl e (num R)) m₀ (Fm.vl ar (num n) (H.suc (H.suc (num R))) e) ∧ Fm.IsNm (H.lvl e (H.suc (H.suc (H.suc (num R))))) (H.lvl e (H.suc (H.suc (num R)))) (H.lvl e (H.suc (num R))) m₀ (Fm.vl ar (num n) (H.suc (H.suc (H.suc (num R)))) e)) :
    CSat (fun i => Fm.AllT ar e (num i) (num R)) q := by
  have hv : Fm.Plc e := ⟨⟨_, he⟩, hlv⟩
  have tv : ∀ i P : N, i + 1 ≤ q → R ≤ P → P + R + 1 ≤ l →
      (Fm.AllT ar e (num i) (num R) ↔ Fm.Tr ar (num i) (num P) e) := by
    intro i P hi h1 h2
    constructor
    · exact fun h => (allT_iff ar).mp h e l P he (fun j a hj => ⟨j, hj⟩) h1 h2
    · intro htr
      rcases hdec i hi with h | h
      · exact h
      · exact ((allF_iff ar).mp h e l P he (fun j a hj => ⟨j, hj⟩) h1 h2 htr).elim
  have hp5 : ∃ b, H.App e (H.suc (H.suc (H.suc (H.suc (H.suc (num R)))))) b := by
    rw [← ar.iso.succ, ← ar.iso.succ, ← ar.iso.succ, ← ar.iso.succ, ← ar.iso.succ]
    exact he.tot (ar.num_mem.mpr (le_trans ((ar.nf.le_iff _ _).mpr ⟨R, by ring⟩) hl))
  have hp4 := hv.down hp5
  have hp3 := hv.down hp4
  have hp2 := hv.down hp3
  have hp1 := hv.down hp2
  have hp0 := hv.down hp1
  have kI0 : ∀ t t' : N, aIn t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aIn t t')) (num R) ↔ Fm.Tin ar t t' (num R) e) := by
    intro t t' hi
    have h := tv (aIn t t') (R) hi ((ar.nf.le_iff _ _).mpr ⟨0, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨5, by ring⟩) hl)
    exact h.trans ((tr_in ar).trans (tinR_iff ar ax hv hp1 t t'))
  have kI1 : ∀ t t' : N, aIn t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aIn t t')) (num R) ↔ Fm.Tin ar t t' (H.suc (num R)) e) := by
    intro t t' hi
    have h := tv (aIn t t') (R + 1) hi ((ar.nf.le_iff _ _).mpr ⟨1, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨4, by ring⟩) hl)
    rw [ar.iso.succ] at h
    exact h.trans ((tr_in ar).trans (tinR_iff ar ax hv hp2 t t'))
  have kI2 : ∀ t t' : N, aIn t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aIn t t')) (num R) ↔ Fm.Tin ar t t' (H.suc (H.suc (num R))) e) := by
    intro t t' hi
    have h := tv (aIn t t') (R + 1 + 1) hi ((ar.nf.le_iff _ _).mpr ⟨2, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨3, by ring⟩) hl)
    rw [ar.iso.succ, ar.iso.succ] at h
    exact h.trans ((tr_in ar).trans (tinR_iff ar ax hv hp3 t t'))
  have kI3 : ∀ t t' : N, aIn t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aIn t t')) (num R) ↔ Fm.Tin ar t t' (H.suc (H.suc (H.suc (num R)))) e) := by
    intro t t' hi
    have h := tv (aIn t t') (R + 1 + 1 + 1) hi ((ar.nf.le_iff _ _).mpr ⟨3, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨2, by ring⟩) hl)
    rw [ar.iso.succ, ar.iso.succ, ar.iso.succ] at h
    exact h.trans ((tr_in ar).trans (tinR_iff ar ax hv hp4 t t'))
  have kI4 : ∀ t t' : N, aIn t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aIn t t')) (num R) ↔ Fm.Tin ar t t' (H.suc (H.suc (H.suc (H.suc (num R))))) e) := by
    intro t t' hi
    have h := tv (aIn t t') (R + 1 + 1 + 1 + 1) hi ((ar.nf.le_iff _ _).mpr ⟨4, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨1, by ring⟩) hl)
    rw [ar.iso.succ, ar.iso.succ, ar.iso.succ, ar.iso.succ] at h
    exact h.trans ((tr_in ar).trans (tinR_iff ar ax hv hp5 t t'))
  have kE0 : ∀ t t' : N, aEq t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aEq t t')) (num R) ↔ Fm.Teq ar t t' (num R) e) := by
    intro t t' hi
    have h := tv (aEq t t') (R) hi ((ar.nf.le_iff _ _).mpr ⟨0, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨5, by ring⟩) hl)
    exact h.trans ((tr_eq ar).trans (teqR_iff ar ax hv hp0 t t'))
  have kE1 : ∀ t t' : N, aEq t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aEq t t')) (num R) ↔ Fm.Teq ar t t' (H.suc (num R)) e) := by
    intro t t' hi
    have h := tv (aEq t t') (R + 1) hi ((ar.nf.le_iff _ _).mpr ⟨1, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨4, by ring⟩) hl)
    rw [ar.iso.succ] at h
    exact h.trans ((tr_eq ar).trans (teqR_iff ar ax hv hp1 t t'))
  have kE2 : ∀ t t' : N, aEq t t' + 1 ≤ q →
      (Fm.AllT ar e (num (aEq t t')) (num R) ↔ Fm.Teq ar t t' (H.suc (H.suc (num R))) e) := by
    intro t t' hi
    have h := tv (aEq t t') (R + 1 + 1) hi ((ar.nf.le_iff _ _).mpr ⟨2, by ring⟩)
      (le_trans ((ar.nf.le_iff _ _).mpr ⟨3, by ring⟩) hl)
    rw [ar.iso.succ, ar.iso.succ] at h
    exact h.trans ((tr_eq ar).trans (teqR_iff ar ax hv hp2 t t'))
  exact
    { u1a := fun s x h1 h2 h => (kE1 _ _ h2).mpr (n_u1 ar ax hv cax s x hp2 ((kI1 _ _ h1).mp h)).1
      u1b := fun s x h1 h2 h => (kI0 _ _ h2).mpr (n_u1 ar ax hv cax s x hp2 ((kI1 _ _ h1).mp h)).2
      u2 := fun a x h1 h2 h => (kI1 _ _ h2).mpr (n_u2 ar ax hv cax a x hp2 ((kI0 _ _ h1).mp h))
      s1a := fun y k h1 h2 h => (kI1 _ _ h2).mpr (n_s1 ar ax hv cax y k hp2 ((kI1 _ _ h1).mp h)).1
      s1b := fun y k h1 h2 h => (kI0 _ _ h2).mpr (n_s1 ar ax hv cax y k hp2 ((kI1 _ _ h1).mp h)).2
      s2 := fun x b k h1 h2 h3 hx hnb => (kI1 _ _ h3).mpr (n_s2 ar ax hv cax x b k hp2
        ((kI1 _ _ h1).mp hx) (fun hb => hnb ((kI0 _ _ h2).mpr hb)))
      n1 := fun h1 => (kI2 _ _ h1).mpr (n_n1 ar ax hv cax hp3)
      n2 := fun k h1 h2 h => (kI2 _ _ h2).mpr (n_n2 ar ax hv cax k hp3 ((kI2 _ _ h1).mp h))
      k := fun x n h1 h2 h3 hx hn => (kI2 _ _ h3).mpr (n_k ar ax hv cax x n hp4 (hnum n h2)
        ((kI1 _ _ h1).mp hx) ((kI2 _ _ h2).mp hn) ((kI3 _ _ h2).mp hn)) }

end FlatM
