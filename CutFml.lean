/-- The value of the term does not depend on the variable `i`. -/
def Fr (N : Type) [CommSemiring N] (k : BTm) (i : ℕ) : Prop :=
  ∀ (e : ℕ → N) (a : N), evalG k (Function.update e i a) = evalG k e

theorem fr_var {j i : ℕ} (h : j ≠ i) : Fr N (.var j) i := fun e a => by
  simp only [evalG]
  exact Function.update_of_ne h a e

theorem fr_one (i : ℕ) : Fr N .one i := fun _ _ => rfl

theorem fr_add {s t : BTm} {i : ℕ} (hs : Fr N s i) (ht : Fr N t i) : Fr N (.add s t) i :=
  fun e a => by
    simp only [evalG]
    rw [hs, ht]

theorem fr_mul {s t : BTm} {i : ℕ} (hs : Fr N s i) (ht : Fr N t i) : Fr N (.mul s t) i :=
  fun e a => by
    simp only [evalG]
    rw [hs, ht]

theorem fr_aIn {s t : BTm} {i : ℕ} (hs : Fr N s i) (ht : Fr N t i) : Fr N (BTm.aIn s t) i :=
  fr_add (fr_add (fr_mul (fr_add hs ht) (fr_add hs ht)) hs)
    (fr_add (fr_mul (fr_add hs ht) (fr_add hs ht)) hs)

theorem fr_aEq {s t : BTm} {i : ℕ} (hs : Fr N s i) (ht : Fr N t i) : Fr N (BTm.aEq s t) i :=
  fr_add (fr_aIn hs ht) (fr_one i)

end evalG

/-! ### The nine clauses as formulas -/

/-- The clause `u1a` for the Axiom of Counting. -/
def csatC_u1a (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (BTm.usT (.var 101))) .one) q) (BFml.imp (.le (.add (BTm.aEq (.var 100) (BTm.sgT (BTm.elT (.var 100)))) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (BTm.usT (.var 101))) τ) (.mem (BTm.aEq (.var 100) (BTm.sgT (BTm.elT (.var 100)))) τ))))))

/-- The clause `u1b` for the Axiom of Counting. -/
def csatC_u1b (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (BTm.usT (.var 101))) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.elT (.var 100)) (.var 101)) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (BTm.usT (.var 101))) τ) (.mem (BTm.aIn (BTm.elT (.var 100)) (.var 101)) τ))))))

/-- The clause `u2` for the Axiom of Counting. -/
def csatC_u2 (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (.var 101)) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.sgT (.var 100)) (BTm.usT (.var 101))) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (.var 101)) τ) (.mem (BTm.aIn (BTm.sgT (.var 100)) (BTm.usT (.var 101))) τ))))))

/-- The clause `s1a` for the Axiom of Counting. -/
def csatC_s1a (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (BTm.scT (.var 101))) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.rmT (.var 100) (BTm.w1T (.var 100) (.var 101))) (.var 101)) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (BTm.scT (.var 101))) τ) (.mem (BTm.aIn (BTm.rmT (.var 100) (BTm.w1T (.var 100) (.var 101))) (.var 101)) τ))))))

/-- The clause `s1b` for the Axiom of Counting. -/
def csatC_s1b (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (BTm.scT (.var 101))) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.w1T (.var 100) (.var 101)) (.var 100)) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (BTm.scT (.var 101))) τ) (.mem (BTm.aIn (BTm.w1T (.var 100) (.var 101)) (.var 100)) τ))))))

/-- The clause `s2` for the Axiom of Counting. -/
def csatC_s2 (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (.all 102 (BFml.imp (.le (.add (BTm.aIn (.var 100) (.var 102)) .one) q) (BFml.imp (.le (.add (BTm.aIn (.var 101) (.var 100)) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.adT (.var 100) (.var 101)) (BTm.scT (.var 102))) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (.var 102)) τ) (BFml.imp (BFml.neg (.mem (BTm.aIn (.var 101) (.var 100)) τ)) (.mem (BTm.aIn (BTm.adT (.var 100) (.var 101)) (BTm.scT (.var 102))) τ)))))))))

/-- The clause `n1` for the Axiom of Counting. -/
def csatC_n1 (τ : ℕ) (q : BTm) : BFml :=
  (BFml.imp (.le (.add (BTm.aIn BTm.zrT BTm.ddT) .one) q) (.mem (BTm.aIn BTm.zrT BTm.ddT) τ))

/-- The clause `n2` for the Axiom of Counting. -/
def csatC_n2 (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (BFml.imp (.le (.add (BTm.aIn (.var 100) BTm.ddT) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.scT (.var 100)) BTm.ddT) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) BTm.ddT) τ) (.mem (BTm.aIn (BTm.scT (.var 100)) BTm.ddT) τ)))))

/-- The clause `k` for the Axiom of Counting. -/
def csatC_k (τ : ℕ) (q : BTm) : BFml :=
  (.all 100 (.all 101 (BFml.imp (.le (.add (BTm.aIn (.var 100) (.var 101)) .one) q) (BFml.imp (.le (.add (BTm.aIn (.var 101) BTm.ddT) .one) q) (BFml.imp (.le (.add (BTm.aIn (BTm.usT (.var 100)) (.var 101)) .one) q) (BFml.imp (.mem (BTm.aIn (.var 100) (.var 101)) τ) (BFml.imp (.mem (BTm.aIn (.var 101) BTm.ddT) τ) (.mem (BTm.aIn (BTm.usT (.var 100)) (.var 101)) τ))))))))

/-- The nine clauses below `q` for the truth assignment given by the set variable `τ`. -/
def csatF (τ : ℕ) (q : BTm) : BFml :=
  (csatC_u1a τ q).and ((csatC_u1b τ q).and ((csatC_u2 τ q).and ((csatC_s1a τ q).and ((csatC_s1b τ q).and ((csatC_s2 τ q).and ((csatC_n1 τ q).and ((csatC_n2 τ q).and ((csatC_k τ q)))))))))

/-! ### The formulas for the correct states, the cut of the terms, membership and equality -/

def sat1X (k : BTm) (S : ℕ) (q : BTm) : BFml :=
  BFml.exS 200 ((agreeF k 200 S).and ((nsatF 200 q).and (csatF 200 q)))

def goodX (k : BTm) (S : ℕ) : BFml :=
  .all 120 (BFml.imp (.inKt (.var 120)) (sat1X k S (.var 120)))

def t1X (k : BTm) (S : ℕ) : BFml :=
  BFml.exS 201 ((agreeF k 201 S).and ((BFml.mem k 201).and (goodX (.add k .one) 201)))

def correctX (k : BTm) (S : ℕ) : BFml :=
  (BFml.all 130 (BFml.imp (.le (.var 130) k) (goodX (.var 130) S))).and
    (.all 130 (BFml.imp (.le (.add (.var 130) .one) k)
      (BFml.iff (.mem (.var 130) S) (t1X (.var 130) S))))

def inJX (k : BTm) : BFml := (BFml.inKt k).and (BFml.exS 202 (correctX k 202))

def k1X (m : BTm) : BFml := .all 140 (BFml.imp (inJX (.var 140)) (inJX (.add (.var 140) m)))

def inIX (n : BTm) : BFml := .all 141 (BFml.imp (k1X (.var 141)) (k1X (.mul (.var 141) n)))

def epsX (t t' : BTm) : BFml :=
  BFml.exS 203 ((correctX (.add (BTm.aIn t t') .one) 203).and (.mem (BTm.aIn t t') 203))

def etaX (t t' : BTm) : BFml :=
  BFml.exS 203 ((correctX (.add (BTm.aEq t t') .one) 203).and (.mem (BTm.aEq t t') 203))

/-- "The number `0` is in the cut of the terms and no smaller number is `Eta`-equal to it". -/
def minTmX : BFml :=
  .and (inIX (.var 0))
    (.all 1 (BFml.imp (.le (.add (.var 1) .one) (.var 0)) (.neg (etaX (.var 1) (.var 0)))))

/-- The membership of the interpretation, in the number variables `0` and `1`. -/
def epsX2 : BFml := epsX (.var 0) (.var 1)

namespace CutSys

variable {N W : Type} [CommSemiring N] [PartialOrder N] [IsOrderedRing N]
  [CanonicallyOrderedAdd N] (C : CutSys N W)

/-- Truth of a formula of `L₂`. -/
def bholds : BFml → (ℕ → N) → (ℕ → W) → Prop
  | .eq s t, e, _ => evalG s e = evalG t e
  | .le s t, e, _ => evalG s e ≤ evalG t e
  | .mem t X, e, s => C.mem (evalG t e) (s X)
  | .inKt t, e, _ => C.cut (evalG t e)
  | .neg φ, e, s => ¬ bholds φ e s
  | .and φ ψ, e, s => bholds φ e s ∧ bholds ψ e s
  | .all x φ, e, s => ∀ a : N, bholds φ (Function.update e x a) s
  | .allS X φ, e, s => ∀ A : W, bholds φ e (Function.update s X A)

theorem bholds_imp {φ ψ : BFml} {e : ℕ → N} {s : ℕ → W} :
    C.bholds (φ.imp ψ) e s ↔ (C.bholds φ e s → C.bholds ψ e s) := by
  simp only [BFml.imp, bholds]
  tauto

theorem bholds_or {φ ψ : BFml} {e : ℕ → N} {s : ℕ → W} :
    C.bholds (φ.or ψ) e s ↔ (C.bholds φ e s ∨ C.bholds ψ e s) := by
  simp only [BFml.or, bholds]
  tauto

theorem bholds_iff {φ ψ : BFml} {e : ℕ → N} {s : ℕ → W} :
    C.bholds (φ.iff ψ) e s ↔ (C.bholds φ e s ↔ C.bholds ψ e s) := by
  simp only [BFml.iff, BFml.imp, bholds]
  tauto

theorem bholds_exS {X : ℕ} {φ : BFml} {e : ℕ → N} {s : ℕ → W} :
    C.bholds (φ.exS X) e s ↔ ∃ A : W, C.bholds φ e (Function.update s X A) := by
  simp only [BFml.exS, bholds]
  exact not_forall_not

set_option maxHeartbeats 8000000 in
set_option maxRecDepth 8000 in
theorem bholds_nsatF (τ : ℕ) (q : BTm) (e : ℕ → N) (s : ℕ → W)
    (hq : ∀ (e : ℕ → N) (i : ℕ) (a : N), 100 ≤ i → i ≤ 108 →
      evalG q (Function.update e i a) = evalG q e) :
    C.bholds (nsatF τ q) e s ↔ NSat (fun i : N => C.mem i (s τ)) (evalG q e) := by
  have hq1 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 100 a) = evalG q e :=
    fun e a => hq e 100 a (by norm_num) (by norm_num)
  have hq2 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 101 a) = evalG q e :=
    fun e a => hq e 101 a (by norm_num) (by norm_num)
  have hq3 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 102 a) = evalG q e :=
    fun e a => hq e 102 a (by norm_num) (by norm_num)
  have hq4 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 103 a) = evalG q e :=
    fun e a => hq e 103 a (by norm_num) (by norm_num)
  have hq5 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 104 a) = evalG q e :=
    fun e a => hq e 104 a (by norm_num) (by norm_num)
  have hq6 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 105 a) = evalG q e :=
    fun e a => hq e 105 a (by norm_num) (by norm_num)
  have hq7 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 106 a) = evalG q e :=
    fun e a => hq e 106 a (by norm_num) (by norm_num)
  have hq8 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 107 a) = evalG q e :=
    fun e a => hq e 107 a (by norm_num) (by norm_num)
  have hq9 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 108 a) = evalG q e :=
    fun e a => hq e 108 a (by norm_num) (by norm_num)
  constructor
  · intro g
    simp only [nsatF, bholds] at g
    obtain ⟨g_e1, g_e2, g_e3, g_e4a, g_e4b, g_m1, g_m2, g_m3, g_m4, g_m5, g_m6, g_m7, g_m8, g_m9a, g_m9b, g_m10a, g_m10b, g_m11, g_m12a, g_m12b, g_m13a, g_m13b⟩ := g
    exact
      {
        e1 := by simpa [nsatC_e1, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_e1
        e2 := by simpa [nsatC_e2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_e2
        e3 := by simpa [nsatC_e3, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_e3
        e4a := by simpa [nsatC_e4a, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_e4a
        e4b := by simpa [nsatC_e4b, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_e4b
        m1 := by simpa [nsatC_m1, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_m1
        m2 := by simpa [nsatC_m2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_m2
        m3 := by simpa [nsatC_m3, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_m3
        m4 := by simpa [nsatC_m4, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3, hq4, hq5, hq6, hq7, hq8, hq9] using g_m4
