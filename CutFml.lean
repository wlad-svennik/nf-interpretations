theorem bholds_csatF (τ : ℕ) (q : BTm) (e : ℕ → N) (s : ℕ → W)
    (hq : ∀ (e : ℕ → N) (i : ℕ) (a : N), 100 ≤ i → i ≤ 108 →
      evalG q (Function.update e i a) = evalG q e) :
    C.bholds (csatF τ q) e s ↔ CSat (fun i : N => C.mem i (s τ)) (evalG q e) := by
  have hq1 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 100 a) = evalG q e :=
    fun e a => hq e 100 a (by norm_num) (by norm_num)
  have hq2 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 101 a) = evalG q e :=
    fun e a => hq e 101 a (by norm_num) (by norm_num)
  have hq3 : ∀ (e : ℕ → N) (a : N), evalG q (Function.update e 102 a) = evalG q e :=
    fun e a => hq e 102 a (by norm_num) (by norm_num)
  constructor
  · intro g
    simp only [csatF, bholds] at g
    obtain ⟨g_u1a, g_u1b, g_u2, g_s1a, g_s1b, g_s2, g_n1, g_n2, g_k⟩ := g
    exact
      {
        u1a := by simpa [csatC_u1a, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_u1a
        u1b := by simpa [csatC_u1b, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_u1b
        u2 := by simpa [csatC_u2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_u2
        s1a := by simpa [csatC_s1a, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_s1a
        s1b := by simpa [csatC_s1b, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_s1b
        s2 := by simpa [csatC_s2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_s2
        n1 := by simpa [csatC_n1, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_n1
        n2 := by simpa [csatC_n2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_n2
        k := by simpa [csatC_k, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using g_k }
  · intro h
    simp only [csatF, bholds]
    exact ⟨by simpa [csatC_u1a, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.u1a,
      by simpa [csatC_u1b, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.u1b,
      by simpa [csatC_u2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.u2,
      by simpa [csatC_s1a, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.s1a,
      by simpa [csatC_s1b, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.s1b,
      by simpa [csatC_s2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.s2,
      by simpa [csatC_n1, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.n1,
      by simpa [csatC_n2, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.n2,
      by simpa [csatC_k, bholds, C.bholds_imp, C.bholds_iff, C.bholds_or, evalG, Function.update_apply, hq1, hq2, hq3] using h.k⟩

theorem bholds_agreeF (k : BTm) (S S' : ℕ) (e : ℕ → N) (s : ℕ → W) (hk : Fr N k 110) :
    C.bholds (agreeF k S S') e s ↔ C.Agree (evalG k e) (s S) (s S') := by
  unfold agreeF Agree
  simp only [bholds, C.bholds_imp, C.bholds_iff, evalG, Function.update_self, hk e]

theorem bholds_sat1X (k : BTm) (S : ℕ) (q : BTm) (e : ℕ → N) (s : ℕ → W) (hS : S ≠ 200)
    (hk : Fr N k 110) (hq : ∀ i, 100 ≤ i → i ≤ 108 → Fr N q i) :
    C.bholds (sat1X k S q) e s ↔ C.Sat1 (evalG k e) (s S) (evalG q e) := by
  unfold sat1X Sat1
  rw [C.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [C.bholds_agreeF k 200 S e _ hk, C.bholds_nsatF 200 q e _ (fun e i a h1 h2 => hq i h1 h2 e a),
    C.bholds_csatF 200 q e _ (fun e i a h1 h2 => hq i h1 h2 e a),
    Function.update_self, Function.update_of_ne hS]

theorem bholds_goodX (k : BTm) (S : ℕ) (e : ℕ → N) (s : ℕ → W) (hS : S ≠ 200)
    (hk : Fr N k 110) (hk' : Fr N k 120) :
    C.bholds (goodX k S) e s ↔ C.Good (evalG k e) (s S) := by
  unfold goodX Good
  simp only [bholds, C.bholds_imp, evalG, Function.update_self]
  refine forall_congr' fun a => imp_congr Iff.rfl ?_
  rw [C.bholds_sat1X k S (.var 120) _ s hS hk
    (fun i h1 h2 => fr_var (by omega)), hk' e a]
  simp only [evalG, Function.update_self]

theorem bholds_t1X (k : BTm) (S : ℕ) (e : ℕ → N) (s : ℕ → W) (hS : S ≠ 201)
    (hk : Fr N k 110) (hk' : Fr N k 120) :
    C.bholds (t1X k S) e s ↔ C.T1 (evalG k e) (s S) := by
  unfold t1X T1
  rw [C.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [C.bholds_agreeF k 201 S e _ hk, C.bholds_goodX (.add k .one) 201 e _ (by norm_num)
    (fr_add hk (fr_one _)) (fr_add hk' (fr_one _)),
    Function.update_self, Function.update_of_ne hS]
  simp only [evalG]

theorem bholds_correctX (k : BTm) (S : ℕ) (e : ℕ → N) (s : ℕ → W) (hS : S ≠ 200)
    (hS' : S ≠ 201) (hk : Fr N k 130) :
    C.bholds (correctX k S) e s ↔ C.Correct (evalG k e) (s S) := by
  unfold correctX Correct
  simp only [bholds, C.bholds_imp, C.bholds_iff, evalG, Function.update_self, hk e]
  refine and_congr (forall_congr' fun a => imp_congr Iff.rfl ?_)
    (forall_congr' fun a => imp_congr Iff.rfl (iff_congr Iff.rfl ?_))
  · rw [C.bholds_goodX (.var 130) S _ s hS (fr_var (by norm_num)) (fr_var (by norm_num))]
    simp only [evalG, Function.update_self]
  · rw [C.bholds_t1X (.var 130) S _ s hS' (fr_var (by norm_num)) (fr_var (by norm_num))]
    simp only [evalG, Function.update_self]

theorem bholds_inJX (k : BTm) (e : ℕ → N) (s : ℕ → W) (hk : Fr N k 130) :
    C.bholds (inJX k) e s ↔ C.InJ (evalG k e) := by
  unfold inJX InJ
  simp only [bholds]
  rw [C.bholds_exS]
  refine and_congr Iff.rfl (exists_congr fun A => ?_)
  rw [C.bholds_correctX k 202 e _ (by norm_num) (by norm_num) hk, Function.update_self]

theorem bholds_k1X (m : BTm) (e : ℕ → N) (s : ℕ → W) (hm : Fr N m 140) (hm' : Fr N m 130) :
    C.bholds (k1X m) e s ↔ Shortening.K₁ C.InJ (fun n : N => n) (evalG m e) := by
  unfold k1X Shortening.K₁ Shortening.C₂
  simp only [bholds, C.bholds_imp]
  refine forall_congr' fun a => ?_
  rw [C.bholds_inJX (.var 140) _ s (fr_var (by norm_num)),
    C.bholds_inJX (.add (.var 140) m) _ s (fr_add (fr_var (by norm_num)) hm')]
  simp only [evalG, Function.update_self, hm e a]

theorem bholds_inIX (n : BTm) (e : ℕ → N) (s : ℕ → W) (hn : Fr N n 141) (hn' : Fr N n 140)
    (hn'' : Fr N n 130) : C.bholds (inIX n) e s ↔ C.InI (evalG n e) := by
  unfold inIX InI Shortening.K
  simp only [bholds, C.bholds_imp]
  refine forall_congr' fun a => ?_
  rw [C.bholds_k1X (.var 141) _ s (fr_var (by norm_num)) (fr_var (by norm_num)),
    C.bholds_k1X (.mul (.var 141) n) _ s (fr_mul (fr_var (by norm_num)) hn')
      (fr_mul (fr_var (by norm_num)) hn'')]
  simp only [evalG, Function.update_self, hn e a]

theorem bholds_epsX (t t' : BTm) (e : ℕ → N) (s : ℕ → W) (ht : Fr N t 130)
    (ht' : Fr N t' 130) : C.bholds (epsX t t') e s ↔ C.Eps (evalG t e) (evalG t' e) := by
  unfold epsX Eps
  rw [C.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [C.bholds_correctX (.add (BTm.aIn t t') .one) 203 e _ (by norm_num) (by norm_num)
    (fr_add (fr_aIn ht ht') (fr_one _)), Function.update_self]
  simp only [evalG, evalG_aIn]

theorem bholds_etaX (t t' : BTm) (e : ℕ → N) (s : ℕ → W) (ht : Fr N t 130)
    (ht' : Fr N t' 130) : C.bholds (etaX t t') e s ↔ C.Eta (evalG t e) (evalG t' e) := by
  unfold etaX Eta
  rw [C.bholds_exS]
  refine exists_congr fun A => ?_
  simp only [bholds]
  rw [C.bholds_correctX (.add (BTm.aEq t t') .one) 203 e _ (by norm_num) (by norm_num)
    (fr_add (fr_aEq ht ht') (fr_one _)), Function.update_self]
  simp only [evalG, evalG_aEq]

/-- **The least terms are given by a formula of `L₂`.** -/
theorem bholds_minTmX (e : ℕ → N) (s : ℕ → W) : C.bholds minTmX e s ↔ C.MinTm (e 0) := by
  unfold minTmX MinTm
  simp only [bholds, C.bholds_imp]
  rw [C.bholds_inIX (.var 0) e s (fr_var (by norm_num)) (fr_var (by norm_num))
    (fr_var (by norm_num))]
  refine and_congr Iff.rfl (forall_congr' fun a => ?_)
  rw [C.bholds_etaX (.var 1) (.var 0) _ s (fr_var (by norm_num)) (fr_var (by norm_num))]
  simp [evalG, Function.update_apply]

/-- **The membership of the interpretation is given by a formula of `L₂`.** -/
theorem bholds_epsX2 (e : ℕ → N) (s : ℕ → W) : C.bholds epsX2 e s ↔ C.Eps (e 0) (e 1) :=
  C.bholds_epsX (.var 0) (.var 1) e s (fr_var (by norm_num)) (fr_var (by norm_num))

