/-!
# The formulas for the term model on a cut

`NFUInterpretsNF.lean` has a two-sorted language `L₂` (`BTm`, `BFml`: number terms, the atoms
`s = t`, `s ≤ t`, `t ∈ X`, "`t` is in the cut", quantifiers over numbers and over sets) and
formulas of it for the term model of NF. Here the formulas are given a meaning in any structure
of numbers and sets with a cut (`CutSys.bholds`), the nine clauses for the Axiom of Counting are
added (`csatF`), and the domain and the membership of the term model of `CutTerm.lean` are
given by formulas:

* `bholds_minTmX : C.bholds minTmX e s ↔ C.MinTm (e 0)`;
* `bholds_epsX2 : C.bholds epsX2 e s ↔ C.Eps (e 0) (e 1)`.

Generated by `gen/gen_cutfml.py`.
-/

open NFUCut

namespace NFUCut.BTm

def usT (x : BTm) : BTm := tm 18 x .zero
def ddT : BTm := tm 19 .zero .zero
def scT (k : BTm) : BTm := tm 20 k .zero
def w1T (y k : BTm) : BTm := tm 21 y k
def emT : BTm := inT c1T (coT c1T)
def zrT : BTm := sgT emT
def unT (x y : BTm) : BTm := coT (inT (coT x) (coT y))
def adT (x b : BTm) : BTm := unT x (sgT b)
def rmT (y b : BTm) : BTm := inT y (coT (sgT b))

end NFUCut.BTm

section evalG

variable {N : Type} [CommSemiring N]

/-- The value of a number term. -/
def evalG : BTm → (ℕ → N) → N
  | .var i, e => e i
  | .zero, _ => 0
  | .one, _ => 1
  | .lit n, _ => (n : N)
  | .add s t, e => evalG s e + evalG t e
  | .mul s t, e => evalG s e * evalG t e

@[simp] theorem evalG_npair (s t : BTm) (e : ℕ → N) :
    evalG (BTm.npair s t) e = npair (evalG s e) (evalG t e) := rfl
@[simp] theorem evalG_tm (f : ℕ) (s t : BTm) (e : ℕ → N) :
    evalG (BTm.tm f s t) e = tm f (evalG s e) (evalG t e) := rfl
@[simp] theorem evalG_aIn (s t : BTm) (e : ℕ → N) :
    evalG (BTm.aIn s t) e = aIn (evalG s e) (evalG t e) := rfl
@[simp] theorem evalG_aEq (s t : BTm) (e : ℕ → N) :
    evalG (BTm.aEq s t) e = aEq (evalG s e) (evalG t e) := rfl
@[simp] theorem evalG_sgT (x : BTm) (e : ℕ → N) : evalG (BTm.sgT x) e = sgT (evalG x e) := rfl
@[simp] theorem evalG_coT (x : BTm) (e : ℕ → N) : evalG (BTm.coT x) e = coT (evalG x e) := rfl
@[simp] theorem evalG_siT (x : BTm) (e : ℕ → N) : evalG (BTm.siT x) e = siT (evalG x e) := rfl
@[simp] theorem evalG_i2T (x : BTm) (e : ℕ → N) : evalG (BTm.i2T x) e = i2T (evalG x e) := rfl
@[simp] theorem evalG_i3T (x : BTm) (e : ℕ → N) : evalG (BTm.i3T x) e = i3T (evalG x e) := rfl
@[simp] theorem evalG_vcT (x : BTm) (e : ℕ → N) : evalG (BTm.vcT x) e = vcT (evalG x e) := rfl
