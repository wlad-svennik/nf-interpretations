theorem cast_cvT (x : ℕ) : ((cvT x : ℕ) : N) = cvT (x : N) := by
  simp only [cvT, cast_tm, Nat.cast_zero]

theorem cast_p1T (x : ℕ) : ((p1T x : ℕ) : N) = p1T (x : N) := by
