module

public import CountClauses
public import HostArith

@[expose] public section

set_option autoImplicit false

/-!
# Truth assignments on the numbers of a host, restricted to the standard numbers

The evaluation of terms in a host gives truth assignments on the codes that are numbers of the
host (`Host.Nm`), which may be nonstandard. The clauses are polynomial in the codes, so the
restriction of such an assignment to the standard numbers satisfies the instances below a
standard bound (`NSat.pull`, `CSat.pull`; generated by `gen/gen_pull.py`).

**`consistent_nfc_of_hosts`**: `𝗡𝗙𝗖` is consistent if for every standard `q` there are a host
and a truth assignment on its numbers that satisfies the instances of N and of the nine clauses
below `q`.
-/

section cast

variable {N : Type} [CommSemiring N]

theorem cast_npair (x y : ℕ) : ((npair x y : ℕ) : N) = npair (x : N) (y : N) := by
  simp only [npair, Nat.cast_add, Nat.cast_mul]

theorem cast_tm (f x y : ℕ) : ((tm f x y : ℕ) : N) = tm f (x : N) (y : N) := by
  simp only [tm, Nat.cast_add, Nat.cast_one, cast_npair, Nat.cast_id]

theorem cast_aIn (x y : ℕ) : ((aIn x y : ℕ) : N) = aIn (x : N) (y : N) := by
  simp only [aIn, Nat.cast_add, cast_npair]

theorem cast_aEq (x y : ℕ) : ((aEq x y : ℕ) : N) = aEq (x : N) (y : N) := by
  simp only [aEq, Nat.cast_add, Nat.cast_one, cast_npair]

theorem cast_sgT (x : ℕ) : ((sgT x : ℕ) : N) = sgT (x : N) := by
  simp only [sgT, cast_tm, Nat.cast_zero]

theorem cast_coT (x : ℕ) : ((coT x : ℕ) : N) = coT (x : N) := by
  simp only [coT, cast_tm, Nat.cast_zero]

theorem cast_siT (x : ℕ) : ((siT x : ℕ) : N) = siT (x : N) := by
  simp only [siT, cast_tm, Nat.cast_zero]

