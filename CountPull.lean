namespace Host.Nm

variable {H : Host}

theorem cast_le (a b : ℕ) (h : a ≤ b) : ((a : ℕ) : Nm H) ≤ ((b : ℕ) : Nm H) := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [Nat.cast_add]
  exact (le_iff _ _).mpr ⟨_, rfl⟩

end Host.Nm

namespace FFL.FirstOrder.SetTheory

/-- **`𝗡𝗙𝗖` is consistent if for every standard `q` there are a host and a truth assignment on
its numbers that satisfies the instances of N and of the nine clauses below `q`.** -/
theorem consistent_nfc_of_hosts
    (h : ∀ q : ℕ, ∃ (H : Host) (τ : H.Nm → Prop), NSat τ ((q : ℕ) : H.Nm) ∧
      CSat τ ((q : ℕ) : H.Nm)) : Entailment.Consistent 𝗡𝗙𝗖 :=
  consistent_nfc_of_clauses fun q => by
    obtain ⟨H, τ, h1, h2⟩ := h q
    exact ⟨fun i => τ ((i : ℕ) : H.Nm), h1.pull Host.Nm.cast_le, h2.pull Host.Nm.cast_le⟩

end FFL.FirstOrder.SetTheory
