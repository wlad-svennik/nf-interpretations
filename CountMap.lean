module

public import CountClauses

@[expose] public section

set_option autoImplicit false

/-!
# Truth assignments pulled back along a homomorphism of the numbers

The clauses are polynomial in the codes, so a truth assignment on a structure of numbers `N'`
that satisfies the instances below `φ q` pulls back, along a homomorphism of semirings
`φ : N →+* N'` that preserves the order, to one on `N` that satisfies the instances below `q`
(`NSat.map`, `CSat.map`; generated by `gen/gen_map.py`). `CountPull.lean` is the case of the
map from the standard numbers.
-/

section map

variable {N N' : Type} [CommSemiring N] [CommSemiring N'] (φ : N →+* N')

theorem map_npair (x y : N) : φ (npair x y) = npair (φ x) (φ y) := by
  simp only [npair, map_add, map_mul]

theorem map_tm (f : ℕ) (x y : N) : φ (tm f x y) = tm f (φ x) (φ y) := by
  simp only [tm, map_add, map_one, map_npair, map_natCast]

theorem map_aIn (x y : N) : φ (aIn x y) = aIn (φ x) (φ y) := by
  simp only [aIn, map_add, map_npair]

theorem map_aEq (x y : N) : φ (aEq x y) = aEq (φ x) (φ y) := by
  simp only [aEq, map_add, map_one, map_npair]

theorem map_sgT (x : N) : φ (sgT x) = sgT (φ x) := by
  simp only [sgT, map_tm, map_zero]

theorem map_coT (x : N) : φ (coT x) = coT (φ x) := by
  simp only [coT, map_tm, map_zero]

theorem map_siT (x : N) : φ (siT x) = siT (φ x) := by
  simp only [siT, map_tm, map_zero]

theorem map_i2T (x : N) : φ (i2T x) = i2T (φ x) := by
  simp only [i2T, map_tm, map_zero]

theorem map_i3T (x : N) : φ (i3T x) = i3T (φ x) := by
  simp only [i3T, map_tm, map_zero]

theorem map_vcT (x : N) : φ (vcT x) = vcT (φ x) := by
  simp only [vcT, map_tm, map_zero]

theorem map_tlT (x : N) : φ (tlT x) = tlT (φ x) := by
  simp only [tlT, map_tm, map_zero]

theorem map_cvT (x : N) : φ (cvT x) = cvT (φ x) := by
  simp only [cvT, map_tm, map_zero]

theorem map_p1T (x : N) : φ (p1T x) = p1T (φ x) := by
  simp only [p1T, map_tm, map_zero]

theorem map_p2T (x : N) : φ (p2T x) = p2T (φ x) := by
  simp only [p2T, map_tm, map_zero]

theorem map_elT (x : N) : φ (elT x) = elT (φ x) := by
  simp only [elT, map_tm, map_zero]

theorem map_usT (x : N) : φ (usT x) = usT (φ x) := by
  simp only [usT, map_tm, map_zero]

theorem map_scT (x : N) : φ (scT x) = scT (φ x) := by
  simp only [scT, map_tm, map_zero]

theorem map_upT (x y : N) : φ (upT x y) = upT (φ x) (φ y) := by
  simp only [upT, map_tm]

theorem map_inT (x y : N) : φ (inT x y) = inT (φ x) (φ y) := by
  simp only [inT, map_tm]

theorem map_dT (x y : N) : φ (dT x y) = dT (φ x) (φ y) := by
  simp only [dT, map_tm]

theorem map_wtT (x y : N) : φ (wtT x y) = wtT (φ x) (φ y) := by
  simp only [wtT, map_tm]

theorem map_wsT (x y : N) : φ (wsT x y) = wsT (φ x) (φ y) := by
  simp only [wsT, map_tm]

theorem map_w1T (x y : N) : φ (w1T x y) = w1T (φ x) (φ y) := by
  simp only [w1T, map_tm]

theorem map_c1T : φ (c1T : N) = c1T := by
  simp only [c1T, map_tm, map_zero]

theorem map_sbT : φ (sbT : N) = sbT := by
  simp only [sbT, map_tm, map_zero]

theorem map_ddT : φ (ddT : N) = ddT := by
  simp only [ddT, map_tm, map_zero]

theorem map_opT (x y : N) : φ (opT x y) = opT (φ x) (φ y) := by
  simp only [opT, map_upT, map_sgT]

theorem map_emT : φ (emT : N) = emT := by
  simp only [emT, map_inT, map_coT, map_c1T]

theorem map_zrT : φ (zrT : N) = zrT := by
  simp only [zrT, map_sgT, map_emT]

theorem map_unT (x y : N) : φ (unT x y) = unT (φ x) (φ y) := by
  simp only [unT, map_coT, map_inT]

theorem map_adT (x y : N) : φ (adT x y) = adT (φ x) (φ y) := by
  simp only [adT, map_unT, map_sgT]

theorem map_rmT (x y : N) : φ (rmT x y) = rmT (φ x) (φ y) := by
  simp only [rmT, map_inT, map_coT, map_sgT]

end map

