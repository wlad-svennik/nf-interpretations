/-- A truth assignment that satisfies the instances below `φ q`, pulled back along `φ`. -/
theorem CSat.map {N N' : Type} [CommSemiring N] [PartialOrder N] [CommSemiring N']
    [PartialOrder N'] (φ : N →+* N') (hle : ∀ a b : N, a ≤ b → φ a ≤ φ b) {τ : N' → Prop} {q : N}
    (h : CSat τ (φ q)) : CSat (fun i : N => τ (φ i)) q := by
  have cb : ∀ a : N, a + 1 ≤ q → φ a + 1 ≤ φ q := fun a ha => by
    have := hle _ _ ha
    rwa [map_add, map_one] at this
  constructor
